#!/sbin/openrc-run
# shellcheck shell=sh
# shellcheck disable=SC2034  # service variables are consumed by openrc-run
# The HAProxy service (sim-network.md §6/§7). Started after networking so its
# public binds resolve. Runs as a non-root user holding only
# CAP_NET_BIND_SERVICE — the one elevated capability in the container — to bind
# the privileged Modbus port 502. `-db` keeps HAProxy in the foreground so
# supervise-daemon can track it. Output goes to the container console log — its
# foreground logging (per-connection and health-check lines) is voluminous and
# unsuited to the small in-memory /var/log tmpfs.

description="HAProxy reverse proxy for the sim<->digital boundary"

supervisor="supervise-daemon"
command="/usr/sbin/haproxy"
command_args="-db -f /etc/haproxy/haproxy.cfg"
command_user="haproxy:haproxy"
capabilities="^cap_net_bind_service"
output_log="/dev/stdout"
error_log="/dev/stderr"

depend() {
    need sim-net
}
