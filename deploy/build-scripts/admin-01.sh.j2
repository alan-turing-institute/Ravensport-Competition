#!/usr/bin/env bash
# Build image for {{ node_name }}. Generated by render.py.
set -euo pipefail
cd "$(dirname "$0")/../.."

IMAGE_ALIAS="ravensport/{{ node_name }}:latest"
BUILD_CTR="rpbuild{{ node_name | replace('-', '') }}-$$"
_RND=$(printf '%04x' $((RANDOM)))
BUILD_NET="rpbadmin${_RND}"

cleanup() {
    incus delete -f "$BUILD_CTR" 2>/dev/null || true
    incus network delete "$BUILD_NET" 2>/dev/null || true
}
trap cleanup EXIT

current_hash=$(sha256sum \
    build/node-build/{{ node_name }}.sh \
    build/network-config/{{ node_name }}.yaml \
    build/hosts/{{ node_name }} \
    build/chrony/{{ node_name }}.conf \
    build/ssh/{{ node_name }}/ssh_host_ed25519_key \
    build/ssh/{{ node_name }}/ssh_host_ed25519_key.pub \
    build/ssh/{{ node_name }}/id_ed25519 \
    build/ssh/{{ node_name }}/id_ed25519.pub \
    build/ssh/{{ node_name }}/ssh_known_hosts \
    build/ssh/{{ node_name }}/ssh_config \
    build/ca/ca.pem \
    build/siem/{{ node_name }}.key \
    build-scripts/keys/wazuh-repo.gpg \
    build/nftables/{{ node_name }}.nft \
    build-scripts/ulogd.conf \
  | sha256sum | cut -d' ' -f1)
stored_hash=$(incus image get-property "$IMAGE_ALIAS" \
    "ravensport.input-hash" 2>/dev/null || echo "")
if [ "$current_hash" = "$stored_hash" ]; then
    echo "  {{ node_name }}: inputs unchanged, skipping"; exit 0
fi

echo "==> Building $IMAGE_ALIAS"
incus network create "$BUILD_NET" \
    ipv4.address=10.98.6.1/24 ipv4.nat=true \
    ipv6.address=none dns.mode=none
incus launch images:ubuntu/24.04/cloud "$BUILD_CTR" --network "$BUILD_NET"
incus exec "$BUILD_CTR" -- cloud-init status --wait
incus exec "$BUILD_CTR" -- apt-get update
incus exec "$BUILD_CTR" -- apt-get install -y --no-install-recommends \
    openssh-client openssh-server
incus exec "$BUILD_CTR" -- apt-get install -y chrony

# The workstation account is local. Its password deliberately matches the
# fms-admin directory/FMS password, but only this deterministic shadow verifier
# is placed in the image. The SSH private identity exists before first sign-in.
ADMIN_USER="{{ systems_administrator.username }}"
ADMIN_UID="{{ systems_administrator_uid }}"
ADMIN_PASSWORD_HASH='{{ systems_administrator_password_hash }}'
ADMIN_HOME="/home/$ADMIN_USER"
incus exec "$BUILD_CTR" -- bash -c "
getent group '$ADMIN_USER' >/dev/null || groupadd --gid '$ADMIN_UID' '$ADMIN_USER'
id '$ADMIN_USER' >/dev/null 2>&1 \
    || useradd --uid '$ADMIN_UID' --gid '$ADMIN_USER' --create-home \
        --shell /bin/bash '$ADMIN_USER'
usermod --password '$ADMIN_PASSWORD_HASH' '$ADMIN_USER'
install -d -o '$ADMIN_UID' -g '$ADMIN_UID' -m 0750 '$ADMIN_HOME'
install -d -o '$ADMIN_UID' -g '$ADMIN_UID' -m 0700 '$ADMIN_HOME/.ssh'
"
incus file push --mode 0600 build/ssh/{{ node_name }}/id_ed25519 \
    "$BUILD_CTR$ADMIN_HOME/.ssh/id_ed25519"
incus file push --mode 0644 build/ssh/{{ node_name }}/id_ed25519.pub \
    "$BUILD_CTR$ADMIN_HOME/.ssh/id_ed25519.pub"
incus exec "$BUILD_CTR" -- chown -R \
    "$ADMIN_UID:$ADMIN_UID" "$ADMIN_HOME"
incus file push --mode 0644 build/ssh/{{ node_name }}/ssh_known_hosts \
    "$BUILD_CTR/etc/ssh/ssh_known_hosts"
incus file push --mode 0644 build/ssh/{{ node_name }}/ssh_config \
    "$BUILD_CTR/etc/ssh/ssh_config.d/50-ravensport-admin.conf"
incus exec "$BUILD_CTR" -- chown root:root \
    /etc/ssh/ssh_known_hosts /etc/ssh/ssh_config.d/50-ravensport-admin.conf

# Deterministic workstation host key; no package-generated alternatives remain.
incus exec "$BUILD_CTR" -- sh -c \
    'rm -f /etc/ssh/ssh_host_rsa_key* /etc/ssh/ssh_host_ecdsa_key* /etc/ssh/ssh_host_ed25519_key*'
incus file push --mode 0600 build/ssh/{{ node_name }}/ssh_host_ed25519_key \
    "$BUILD_CTR/etc/ssh/ssh_host_ed25519_key"
incus file push --mode 0644 build/ssh/{{ node_name }}/ssh_host_ed25519_key.pub \
    "$BUILD_CTR/etc/ssh/ssh_host_ed25519_key.pub"
incus exec "$BUILD_CTR" -- tee /etc/ssh/sshd_config.d/50-ravensport-login.conf \
    > /dev/null <<SSHDCONF
HostKey /etc/ssh/ssh_host_ed25519_key
UsePAM yes
PermitRootLogin no
PasswordAuthentication yes
KbdInteractiveAuthentication no
PubkeyAuthentication no
AuthenticationMethods password
AllowUsers $ADMIN_USER
AllowAgentForwarding no
X11Forwarding no
AllowTcpForwarding no
PermitTunnel no
SSHDCONF
incus exec "$BUILD_CTR" -- install -d -o root -g root -m 0755 /run/sshd
incus exec "$BUILD_CTR" -- sshd -t
{% include "_journald-system-only.sh.j2" %}

{% include "_trust_ca.sh.j2" %}
{% include "_static-network.sh.j2" %}
{% include "_wazuh-agent.sh.j2" %}

incus exec "$BUILD_CTR" -- systemctl enable chrony
incus exec "$BUILD_CTR" -- systemctl enable \
    ssh ravensport-hosts.service systemd-networkd
{% include "_no-external-services.sh.j2" %}
incus exec "$BUILD_CTR" -- cloud-init clean --logs --seed
incus exec "$BUILD_CTR" -- apt-get purge -y cloud-init
incus exec "$BUILD_CTR" -- rm -rf /var/lib/cloud /etc/cloud
{% include "_clear-build-logs.sh.j2" %}

incus stop "$BUILD_CTR"
incus image delete "$IMAGE_ALIAS" 2>/dev/null || true
incus publish "$BUILD_CTR" --alias "$IMAGE_ALIAS"
incus image set-property "$IMAGE_ALIAS" "ravensport.input-hash" "$current_hash"
echo "==> $IMAGE_ALIAS ready"
