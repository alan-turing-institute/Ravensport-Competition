#!/usr/bin/env bash
# Build image for {{ node_name }}. Generated by render.py.
#
# The operational-technology log server (hist.md §10.2): both stores bound to
# loopback, both ingestion agents fanning out to the replica at hist-dmz-01
# over TLS, and Grafana terminating TLS on 443 with a single seeded account —
# vmagent, vlagent, and Grafana all sharing one CA-signed keypair at
# /etc/hist-tls/ (hist.md §9.1, §10.2).
set -euo pipefail
cd "$(dirname "$0")/../.."

if [ ! -f build/tls/{{ node_name }}/cert.pem ] || [ ! -f build/tls/{{ node_name }}/key.pem ]; then
    echo "ERROR: CA-signed certificate not found at build/tls/{{ node_name }}/ — run make build-ca first." >&2
    exit 1
fi
# The two halves have two producers: render.py rewrites key.pem on every render,
# while cert.pem is build-ca.sh's and is preserved across a render. A render
# following a changed crypto.password_salt_seed or crypto.ca_not_before
# therefore leaves a new key beside a certificate signed from the previous one —
# both present, both valid, no longer a pair. Running this script directly
# rather than through `make build-node-images` skips the build-ca dependency and
# would install that mismatch, which vmagent, vlagent, and Grafana all reject at
# startup. Comparing the moduli is the only check that distinguishes a stale
# certificate from a current one; existence, above, does not.
if [ "$(openssl x509 -noout -modulus -in build/tls/{{ node_name }}/cert.pem)" \
  != "$(openssl rsa -noout -modulus -in build/tls/{{ node_name }}/key.pem)" ]; then
    echo "ERROR: build/tls/{{ node_name }}/cert.pem was not signed for key.pem — the two are from different renders. Run make build-ca first." >&2
    exit 1
fi

{% include "_artefacts.sh.j2" %}

# Fetched before the input hash below reads them, and before any container
# exists to clean up if a download fails.
VICTORIA_METRICS_TGZ=$(fetch_artefact victoria-metrics)
VMUTILS_TGZ=$(fetch_artefact vmutils)
VICTORIA_LOGS_TGZ=$(fetch_artefact victoria-logs)
VLUTILS_TGZ=$(fetch_artefact vlutils)
GRAFANA_DEB=$(fetch_artefact grafana)
VL_DATASOURCE_TGZ=$(fetch_artefact victoriametrics-logs-datasource)

IMAGE_ALIAS="ravensport/{{ node_name }}:latest"
BUILD_CTR="rpbuild{{ node_name | replace('-', '') }}-$$"
_RND=$(printf '%04x' $((RANDOM)))
BUILD_NET="rpb{{ (node_name | replace('-', ''))[:8] }}${_RND}"

cleanup() {
    incus delete -f "$BUILD_CTR" 2>/dev/null || true
    incus network delete "$BUILD_NET" 2>/dev/null || true
}
trap cleanup EXIT

current_hash=$(sha256sum \
    build/node-build/{{ node_name }}.sh \
    build/network-config/{{ node_name }}.yaml \
    build/hosts/{{ node_name }} \
    build/chrony/{{ node_name }}.conf \
    build/ssh/{{ node_name }}/ssh_host_ed25519_key \
    build/ssh/{{ node_name }}/ssh_host_ed25519_key.pub \
    build/ssh/{{ node_name }}/authorized_keys \
    build/grafana/{{ node_name }}-user-seed.sql \
    build/grafana/{{ node_name }}-grafana.ini \
    build/grafana/{{ node_name }}-datasources.yaml \
    build/grafana/{{ node_name }}-dashboards.yaml \
    build/grafana/{{ node_name }}-dashboard.json \
    build/victoria-metrics/{{ node_name }}-scrape.yml \
    "$VICTORIA_METRICS_TGZ" \
    "$VMUTILS_TGZ" \
    "$VICTORIA_LOGS_TGZ" \
    "$VLUTILS_TGZ" \
    "$GRAFANA_DEB" \
    "$VL_DATASOURCE_TGZ" \
    build/tls/{{ node_name }}/cert.pem \
    build/tls/{{ node_name }}/key.pem \
    build/ca/ca.pem \
    build/siem/{{ node_name }}.key \
    build-scripts/keys/wazuh-repo.gpg \
    build/nftables/{{ node_name }}.nft \
    build-scripts/ulogd.conf \
  | sha256sum | cut -d' ' -f1)
stored_hash=$(incus image get-property "$IMAGE_ALIAS" "ravensport.input-hash" 2>/dev/null || echo "")
if [ "$current_hash" = "$stored_hash" ]; then
    echo "  {{ node_name }}: inputs unchanged, skipping"; exit 0
fi

echo "==> Building $IMAGE_ALIAS"
incus network create "$BUILD_NET" \
    ipv4.address=10.98.0.1/24 ipv4.nat=true \
    ipv6.address=none dns.mode=none
incus launch images:ubuntu/24.04/cloud "$BUILD_CTR" --network "$BUILD_NET"
incus exec "$BUILD_CTR" -- cloud-init status --wait
# The base image's package index is frozen at its daily's build time, and the
# pool keeps only current versions, so a package superseded since then 404s.
incus exec "$BUILD_CTR" -- apt-get update
incus exec "$BUILD_CTR" -- apt-get install -y chrony
{% include "_managed-ssh.sh.j2" %}
# sqlite3 applies the Grafana seed below and is purged once it has; it is a
# build-time tool, not part of the deployed host.
incus exec "$BUILD_CTR" -- apt-get install -y sqlite3

# ── Store and agent binaries ──────────────────────────────────────────────────
# Each tarball is pushed in from the build-host cache and only the one binary
# this host runs is unpacked. The utilities tarballs carry six other tools
# between them (hist.md §2.1); none has a use here.
incus file push "$VICTORIA_METRICS_TGZ" "$BUILD_CTR/tmp/victoria-metrics.tar.gz"
incus exec "$BUILD_CTR" -- tar -xzf /tmp/victoria-metrics.tar.gz -C /usr/local/bin victoria-metrics-prod
incus exec "$BUILD_CTR" -- mv /usr/local/bin/victoria-metrics-prod /usr/local/bin/victoria-metrics

incus file push "$VMUTILS_TGZ" "$BUILD_CTR/tmp/vmutils.tar.gz"
incus exec "$BUILD_CTR" -- tar -xzf /tmp/vmutils.tar.gz -C /usr/local/bin vmagent-prod
incus exec "$BUILD_CTR" -- mv /usr/local/bin/vmagent-prod /usr/local/bin/vmagent

incus file push "$VICTORIA_LOGS_TGZ" "$BUILD_CTR/tmp/victoria-logs.tar.gz"
incus exec "$BUILD_CTR" -- tar -xzf /tmp/victoria-logs.tar.gz -C /usr/local/bin victoria-logs-prod
incus exec "$BUILD_CTR" -- mv /usr/local/bin/victoria-logs-prod /usr/local/bin/victoria-logs

incus file push "$VLUTILS_TGZ" "$BUILD_CTR/tmp/vlutils.tar.gz"
incus exec "$BUILD_CTR" -- tar -xzf /tmp/vlutils.tar.gz -C /usr/local/bin vlagent-prod
incus exec "$BUILD_CTR" -- mv /usr/local/bin/vlagent-prod /usr/local/bin/vlagent

incus exec "$BUILD_CTR" -- rm -f /tmp/victoria-metrics.tar.gz /tmp/vmutils.tar.gz \
    /tmp/victoria-logs.tar.gz /tmp/vlutils.tar.gz

# One unprivileged account per service, each owning only its own data directory,
# so that a fault in one service reaches neither the others' records nor a shell.
{% for service in ["victoria-metrics", "vmagent", "victoria-logs", "vlagent"] %}
incus exec "$BUILD_CTR" -- useradd --system --no-create-home --shell /usr/sbin/nologin {{ service }}
incus exec "$BUILD_CTR" -- mkdir -p /var/lib/{{ service }}
incus exec "$BUILD_CTR" -- chown {{ service }}:{{ service }} /var/lib/{{ service }}
{% endfor %}

# ── Shared TLS keypair (hist.md §9.1/§10.2) ───────────────────────────────────
# One CA-signed keypair, installed once at /etc/hist-tls/, presented by every
# TLS-terminating service on this host — vmagent, vlagent, and Grafana (added
# below, once its account exists). victoria-metrics/victoria-logs are not
# members: their loopback listeners carry no -tls flags of their own, so group
# membership would grant private-key access neither service reads.
incus exec "$BUILD_CTR" -- groupadd --system hist-tls
incus exec "$BUILD_CTR" -- mkdir -p /etc/hist-tls
incus file push build/tls/{{ node_name }}/cert.pem "$BUILD_CTR/etc/hist-tls/cert.pem"
incus file push build/tls/{{ node_name }}/key.pem "$BUILD_CTR/etc/hist-tls/key.pem"
incus exec "$BUILD_CTR" -- chown root:hist-tls /etc/hist-tls/key.pem
incus exec "$BUILD_CTR" -- chmod 644 /etc/hist-tls/cert.pem
incus exec "$BUILD_CTR" -- chmod 640 /etc/hist-tls/key.pem
incus exec "$BUILD_CTR" -- usermod -aG hist-tls vmagent
incus exec "$BUILD_CTR" -- usermod -aG hist-tls vlagent

# ── Self-monitoring scrape (hist.md §7.1) ─────────────────────────────────────
# The four local /metrics endpoints, collected so that the operations dashboard
# has something to draw. VictoriaMetrics does the scraping rather than vmagent:
# it stores locally and originates no remote-write, so this host's own telemetry
# cannot reach hist-dmz-01, whereas everything vmagent scrapes would go to both
# of §6's targets.
incus exec "$BUILD_CTR" -- mkdir -p {{ scrape_config_dir }}
incus file push --mode 0640 build/victoria-metrics/{{ node_name }}-scrape.yml \
    "$BUILD_CTR{{ scrape_config_path }}"
incus exec "$BUILD_CTR" -- chown -R victoria-metrics:victoria-metrics \
    {{ scrape_config_dir }}

# ── Systemd units (hist.md §9.1, §10.1) ───────────────────────────────────────
incus exec "$BUILD_CTR" -- tee /etc/systemd/system/victoria-metrics.service > /dev/null <<'UNIT'
[Unit]
Description=VictoriaMetrics time-series store
After=network-online.target
Wants=network-online.target

[Service]
User=victoria-metrics
ExecStart=/usr/local/bin/victoria-metrics \
    -storageDataPath=/var/lib/victoria-metrics \
    -httpListenAddr=127.0.0.1:8428 \
    -retentionPeriod=3y \
    -promscrape.config={{ scrape_config_path }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

incus exec "$BUILD_CTR" -- tee /etc/systemd/system/victoria-logs.service > /dev/null <<'UNIT'
[Unit]
Description=VictoriaLogs structured event store
After=network-online.target
Wants=network-online.target

[Service]
User=victoria-logs
ExecStart=/usr/local/bin/victoria-logs \
    -storageDataPath=/var/lib/victoria-logs \
    -httpListenAddr=127.0.0.1:9428 \
    -retentionPeriod=3y
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

# Each agent writes to its local store and to the replica. The two targets keep
# independent on-disk buffers, so the replica being unreachable delays
# replication without stalling local ingestion.
incus exec "$BUILD_CTR" -- tee /etc/systemd/system/vmagent.service > /dev/null <<'UNIT'
[Unit]
Description=vmagent metric ingestion and replication
After=network-online.target victoria-metrics.service
Wants=network-online.target

[Service]
User=vmagent
ExecStart=/usr/local/bin/vmagent \
    -httpListenAddr=0.0.0.0:8429 \
    -tls \
    -tlsCertFile=/etc/hist-tls/cert.pem \
    -tlsKeyFile=/etc/hist-tls/key.pem \
    -remoteWrite.url=http://127.0.0.1:8428/api/v1/write \
    -remoteWrite.url=https://hist-dmz-01:8428/api/v1/write \
    -remoteWrite.tmpDataPath=/var/lib/vmagent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

# Syslog on 6514 (RFC 5425, TLS) rather than the plain-TCP 514 this listener
# used before the internal CA was available — an unprivileged port, so unlike
# before, vlagent needs no CAP_NET_BIND_SERVICE.
incus exec "$BUILD_CTR" -- tee /etc/systemd/system/vlagent.service > /dev/null <<'UNIT'
[Unit]
Description=vlagent event ingestion and replication
After=network-online.target victoria-logs.service
Wants=network-online.target

[Service]
User=vlagent
ExecStart=/usr/local/bin/vlagent \
    -httpListenAddr=0.0.0.0:9429 \
    -tls \
    -tlsCertFile=/etc/hist-tls/cert.pem \
    -tlsKeyFile=/etc/hist-tls/key.pem \
    -syslog.listenAddr.tcp=0.0.0.0:6514 \
    -syslog.tls \
    -syslog.tlsCertFile=/etc/hist-tls/cert.pem \
    -syslog.tlsKeyFile=/etc/hist-tls/key.pem \
    -remoteWrite.url=http://127.0.0.1:9428/insert/native \
    -remoteWrite.url=https://hist-dmz-01:9428/insert/native \
    -remoteWrite.tmpDataPath=/var/lib/vlagent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

# ── Grafana ───────────────────────────────────────────────────────────────────
incus file push "$GRAFANA_DEB" "$BUILD_CTR/tmp/grafana.deb"
incus exec "$BUILD_CTR" -- apt-get install -y /tmp/grafana.deb
incus exec "$BUILD_CTR" -- rm -f /tmp/grafana.deb

# The VictoriaLogs datasource plugin, unpacked from the pinned archive rather
# than installed through grafana-cli, which would make the build depend on the
# Grafana plugin catalogue. The archive expands to one directory whose name is
# the plugin identifier the provisioning below names as its type.
incus exec "$BUILD_CTR" -- mkdir -p /var/lib/grafana/plugins
incus file push "$VL_DATASOURCE_TGZ" "$BUILD_CTR/tmp/vl-datasource.tar.gz"
incus exec "$BUILD_CTR" -- tar -xzf /tmp/vl-datasource.tar.gz -C /var/lib/grafana/plugins
incus exec "$BUILD_CTR" -- rm -f /tmp/vl-datasource.tar.gz
incus exec "$BUILD_CTR" -- chown -R grafana:grafana /var/lib/grafana/plugins

# Grafana's account exists now that its package is installed, so it can join
# hist-tls (created above, alongside vmagent/vlagent) and read the shared
# CA-signed keypair at /etc/hist-tls/ that grafana.ini below points at —
# hist.md §9/§10.2, the same certificate vmagent and vlagent present.
incus exec "$BUILD_CTR" -- usermod -aG hist-tls grafana

incus file push --mode 0640 build/grafana/{{ node_name }}-grafana.ini "$BUILD_CTR/etc/grafana/grafana.ini"
incus exec "$BUILD_CTR" -- mkdir -p /etc/grafana/provisioning/datasources
incus file push --mode 0640 build/grafana/{{ node_name }}-datasources.yaml "$BUILD_CTR/etc/grafana/provisioning/datasources/ravensport.yaml"
incus exec "$BUILD_CTR" -- chown root:grafana /etc/grafana/grafana.ini \
    /etc/grafana/provisioning/datasources/ravensport.yaml

# The provisioned dashboard (hist.md §7.1). The provider goes in the provisioning
# tree beside the datasources; the dashboard it names goes in Grafana's own data
# directory, since the provisioning tree holds providers rather than dashboards.
# Pushed before Grafana is started below, so the start that creates the schema is
# also the one that applies this.
incus exec "$BUILD_CTR" -- mkdir -p /etc/grafana/provisioning/dashboards
incus file push --mode 0640 build/grafana/{{ node_name }}-dashboards.yaml \
    "$BUILD_CTR/etc/grafana/provisioning/dashboards/ravensport.yaml"
incus exec "$BUILD_CTR" -- chown root:grafana \
    /etc/grafana/provisioning/dashboards/ravensport.yaml
incus exec "$BUILD_CTR" -- mkdir -p {{ dashboard_dir }}
incus file push --mode 0640 build/grafana/{{ node_name }}-dashboard.json \
    "$BUILD_CTR{{ dashboard_dir }}/{{ dashboard.uid }}.json"
incus exec "$BUILD_CTR" -- chown -R grafana:grafana {{ dashboard_dir }}

# Grafana's packaged unit runs as the grafana user, which cannot bind 443
# without this. A drop-in rather than a replacement unit, so a package upgrade
# keeps whatever else the vendor unit sets.
#
# Both lines are needed. That unit sets CapabilityBoundingSet= — emptying it —
# and systemd refuses to put a capability in the ambient set that the bounding
# set does not contain, so the ambient line on its own is inert. Raising the
# ceiling to this one capability leaves the rest of the vendor unit's hardening
# in place.
incus exec "$BUILD_CTR" -- mkdir -p /etc/systemd/system/grafana-server.service.d
incus exec "$BUILD_CTR" -- tee /etc/systemd/system/grafana-server.service.d/10-ravensport.conf > /dev/null <<'UNIT'
[Service]
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
UNIT
incus exec "$BUILD_CTR" -- systemctl daemon-reload

# The seeded account replaces Grafana's default admin/admin row, which only
# exists once Grafana has run its migrations. So Grafana is started once here to
# create the schema, stopped, and seeded before it is enabled for the deployed
# image. Grafana's own password paths are not used: each generates a fresh salt
# when it runs, which would discard the deterministic hash (hist.md §7).
incus exec "$BUILD_CTR" -- systemctl start grafana-server
# sqlite3 creates the database file when it opens one that does not exist, even 
# for a SELECT. If the poll starts before Grafana has finished starting, a 
# read-write probe would create a root-owned grafana.db that
# Grafana cannot then write to, and every migration fails with "attempt to write
# a readonly database".
# Grafana's first-start migrations take far longer when another build loads
# the same disk: under that load they outlasted a wait of 60 seconds. The wait
# is therefore 300 seconds, and a Grafana that is ready sooner ends it sooner.
incus exec "$BUILD_CTR" -- bash -c '
for _ in $(seq 1 300); do
    if sqlite3 -readonly /var/lib/grafana/grafana.db "SELECT 1 FROM \"user\" WHERE id = 1;" 2>/dev/null | grep -q 1; then
        exit 0
    fi
    sleep 1
done
echo "ERROR: Grafana did not create its schema within 300 seconds" >&2
# Ownership and mode of the data directory first
echo "--- /var/lib/grafana ---" >&2
ls -ln /var/lib/grafana >&2 || true
journalctl -u grafana-server --no-pager --lines 40 >&2
exit 1'
# Migrations run before the HTTP server starts, so the wait above is satisfied by
# a Grafana that then dies binding its port — which is how a grafana.ini naming a
# setting Grafana does not read once reached a deployed instance behind a green
# build. Confirm the service is still up before stopping it.
incus exec "$BUILD_CTR" -- bash -c '
if ! systemctl is-active --quiet grafana-server; then
    echo "ERROR: grafana-server created its schema and then exited" >&2
    journalctl -u grafana-server --no-pager --lines 40 >&2
    exit 1
fi'

# The dashboard being retrievable is what shows the provider found the file,
# parsed it, and accepted it. Nothing else in this build would notice if it had
# not: Grafana logs a malformed dashboard and carries on serving, so a provider
# naming the wrong directory, a JSON syntax error, or a file the grafana user
# cannot read all produce a healthy service with no dashboard — the state
# hist.md §7.1 exists to end, found here rather than by the administrator.
#
# Asked of Grafana's HTTP API rather than its database. Grafana 12.4 serves
# dashboards from unified storage, so which table a provisioned dashboard lands
# in is a property of the storage layer and can change with a version. The API
# answers the question actually being asked — whether this dashboard can be
# retrieved — and is the path the administrator's browser takes. admin/admin is
# still Grafana's own default at this point: the seed replacing it is applied
# below, after this service is stopped.
#
# The poll is every two seconds rather than every second: Grafana logs
# SQLITE_BUSY against its own database while starting, and there is no reason for
# this loop to add to the contention.
incus exec "$BUILD_CTR" -- bash -c "
command -v curl >/dev/null || {
    echo 'ERROR: curl is absent from the build container, so the dashboard check' >&2
    echo 'cannot run. It is not installed here deliberately: adding it would put' >&2
    echo 'it in the published image.' >&2
    exit 1
}
for _ in \$(seq 1 150); do
    if curl -sk -o /dev/null -w '%{http_code}' -u admin:admin \\
        https://127.0.0.1/api/dashboards/uid/{{ dashboard.uid }} 2>/dev/null | grep -q 200; then
        exit 0
    fi
    sleep 2
done
echo 'ERROR: Grafana did not provision {{ dashboard.uid }} within 300 seconds' >&2
echo '--- provisioning tree ---' >&2
ls -lR /etc/grafana/provisioning >&2
echo '--- dashboard directory: owner and mode decide whether grafana can read it ---' >&2
ls -ln {{ dashboard_dir }} >&2
echo '--- provisioning log lines ---' >&2
journalctl -u grafana-server --no-pager | grep -i provision >&2 \\
    || echo '(none: the provider was never read)' >&2
echo '--- what the API returns ---' >&2
curl -sk -u admin:admin https://127.0.0.1/api/search?type=dash-db >&2
echo >&2
journalctl -u grafana-server --no-pager --lines 40 >&2
exit 1"

# Grafana installs its preinstall set on first start, asynchronously, and logs a
# failure rather than refusing to serve — so nothing above proves which plugins
# this image carries. hist.md §2.1 pins every plugin and §10.2 unpacks the one we
# want from an archive precisely to keep the build off the plugin catalogue;
# `preinstall_disabled` in grafana.ini is what stops the rest, and this asserts it
# worked. The setting governs a product internal, so it is checked rather than
# assumed.
PINNED_PLUGIN=victoriametrics-logs-datasource
incus exec "$BUILD_CTR" -- bash -c "
unpinned=\$(ls /var/lib/grafana/plugins | grep -v '^$PINNED_PLUGIN\$' || true)
if [ -n \"\$unpinned\" ]; then
    echo 'ERROR: unpinned plugins reached the image:' >&2
    echo \"\$unpinned\" >&2
    echo 'hist.md §2.1 pins every artefact by version and checksum. These carry' >&2
    echo 'neither and are outside current_hash, so identical inputs can produce' >&2
    echo 'different images. Check [plugins] preinstall_disabled in grafana.ini' >&2
    echo 'against this Grafana version.' >&2
    exit 1
fi"

incus exec "$BUILD_CTR" -- systemctl stop grafana-server

incus file push --mode 0600 build/grafana/{{ node_name }}-user-seed.sql "$BUILD_CTR/tmp/grafana-user-seed.sql"
incus exec "$BUILD_CTR" -- bash -c 'sqlite3 /var/lib/grafana/grafana.db < /tmp/grafana-user-seed.sql'
# The seed was applied as root, and Grafana creates its database under the
# build's umask, which leaves it world-readable — Grafana says so at every
# start, and the file holds the administrator's password hash and salt.
incus exec "$BUILD_CTR" -- chown grafana:grafana /var/lib/grafana/grafana.db
incus exec "$BUILD_CTR" -- chmod 640 /var/lib/grafana/grafana.db
# The seed carries a working credential hash and salt, so it does not stay in
# the image (deployment-config.md §4).
incus exec "$BUILD_CTR" -- rm -f /tmp/grafana-user-seed.sql
incus exec "$BUILD_CTR" -- apt-get purge -y sqlite3

incus file push --mode 0600 build/network-config/{{ node_name }}.yaml \
    "$BUILD_CTR/etc/netplan/99-ravensport.yaml"
incus exec "$BUILD_CTR" -- rm -f /etc/netplan/50-cloud-init.yaml
# Generate systemd-networkd .network unit files by parsing the netplan YAML
# directly.  Using the netplan CLI's generator is unreliable: it targets
# /run/systemd/network/ (a tmpfs) which is not preserved in the published
# image, and renderer detection may select NetworkManager rather than networkd.
incus exec "$BUILD_CTR" -- tee /tmp/gen-networkd.py > /dev/null << 'PYEOF'
import yaml, os
os.makedirs("/etc/systemd/network", exist_ok=True)
with open("/etc/netplan/99-ravensport.yaml") as f:
    cfg = yaml.safe_load(f)
for iface, spec in (cfg.get("ethernets") or {}).items():
    lines = ["[Match]", f"Name={iface}", "", "[Network]"]
    for addr in (spec.get("addresses") or []):
        lines.append(f"Address={addr}")
    routes = spec.get("routes") or []
    for r in routes:
        if str(r.get("to")) == "default":
            lines.append(f"Gateway={r['via']}")
    for dns in ((spec.get("nameservers") or {}).get("addresses") or []):
        lines.append(f"DNS={dns}")
    for r in routes:
        if str(r.get("to")) != "default":
            lines += ["", "[Route]", f"Destination={r['to']}", f"Gateway={r['via']}"]
    path = f"/etc/systemd/network/10-ravensport-{iface}.network"
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    print(f"Wrote {path}")
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/gen-networkd.py
incus exec "$BUILD_CTR" -- rm /tmp/gen-networkd.py
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts"
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts.ravensport"
incus file push build/chrony/{{ node_name }}.conf "$BUILD_CTR/etc/chrony/chrony.conf"

incus exec "$BUILD_CTR" -- tee /etc/systemd/system/ravensport-hosts.service > /dev/null <<'UNIT'
[Unit]
Description=Restore /etc/hosts from Ravensport canonical source
DefaultDependencies=no
Before=network-pre.target sysinit.target
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/bin/cp /etc/hosts.ravensport /etc/hosts
RemainAfterExit=yes
[Install]
WantedBy=sysinit.target
UNIT
incus exec "$BUILD_CTR" -- systemctl daemon-reload
incus exec "$BUILD_CTR" -- systemctl enable victoria-metrics.service vmagent.service victoria-logs.service vlagent.service
incus exec "$BUILD_CTR" -- systemctl enable grafana-server.service ravensport-hosts.service systemd-networkd chrony
{% include "_trust_ca.sh.j2" %}
{% include "_wazuh-agent.sh.j2" %}
incus exec "$BUILD_CTR" -- bash -c 'echo ok > /run/ready'
{% include "_no-external-services.sh.j2" %}
# Purge cloud-init — remove the package and residue rather than disabling it,
# so the tree cannot be re-created on the next boot.
incus exec "$BUILD_CTR" -- cloud-init clean --logs --seed
incus exec "$BUILD_CTR" -- apt-get purge -y cloud-init
incus exec "$BUILD_CTR" -- rm -rf /var/lib/cloud /etc/cloud
{% include "_clear-build-logs.sh.j2" %}

incus stop "$BUILD_CTR"
incus image delete "$IMAGE_ALIAS" 2>/dev/null || true
incus publish "$BUILD_CTR" --alias "$IMAGE_ALIAS"
incus image set-property "$IMAGE_ALIAS" "ravensport.input-hash" "$current_hash"
echo "==> $IMAGE_ALIAS ready"
