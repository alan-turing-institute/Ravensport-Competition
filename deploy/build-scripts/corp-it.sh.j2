#!/usr/bin/env bash
# Build image for corp-it. Generated by render.py.
set -euo pipefail
cd "$(dirname "$0")/../.."

if [ ! -f build/tls/corp-it/cert.pem ] || [ ! -f build/tls/corp-it/key.pem ]; then
    echo "ERROR: CA-signed certificate not found at build/tls/corp-it/ — run make build-ca first." >&2
    exit 1
fi
# The two halves have two producers: render.py rewrites key.pem on every render,
# while cert.pem is build-ca.sh's and is preserved across a render. A render
# following a changed crypto.password_salt_seed or crypto.ca_not_before
# therefore leaves a new key beside a certificate signed from the previous one —
# both present, both valid, no longer a pair. Running this script directly
# rather than through `make build-node-images` skips the build-ca dependency and
# would install that mismatch, which OpenLDAP rejects at startup. Comparing
# the moduli is the only check that distinguishes a stale certificate from a
# current one; existence, above, does not.
if [ "$(openssl x509 -noout -modulus -in build/tls/corp-it/cert.pem)" \
  != "$(openssl rsa -noout -modulus -in build/tls/corp-it/key.pem)" ]; then
    echo "ERROR: build/tls/corp-it/cert.pem was not signed for key.pem — the two are from different renders. Run make build-ca first." >&2
    exit 1
fi

IMAGE_ALIAS="ravensport/corp-it:latest"
BUILD_CTR="rpbuildcorpit-$$"
_RND=$(printf '%04x' $((RANDOM)))
BUILD_NET="rpbcorpit${_RND}"

cleanup() {
    incus delete -f "$BUILD_CTR" 2>/dev/null || true
    incus network delete "$BUILD_NET" 2>/dev/null || true
}
trap cleanup EXIT

current_hash=$(sha256sum \
    build/node-build/corp-it.sh \
    build/ldif/corp-it.ldif \
    build/network-config/corp-it.yaml \
    build/hosts/{{ node_name }} \
    build/chrony/{{ node_name }}.conf \
    build/tls/corp-it/cert.pem \
    build/tls/corp-it/key.pem \
    build/ca/ca.pem \
    build/siem/{{ node_name }}.key \
    build-scripts/keys/wazuh-repo.gpg \
    build/nftables/{{ node_name }}.nft \
    build-scripts/ulogd.conf \
  | sha256sum | cut -d' ' -f1)
stored_hash=$(incus image get-property "$IMAGE_ALIAS" "ravensport.input-hash" 2>/dev/null || echo "")
if [ "$current_hash" = "$stored_hash" ]; then
    echo "  corp-it: inputs unchanged, skipping"; exit 0
fi

echo "==> Building $IMAGE_ALIAS"
incus network create "$BUILD_NET" \
    ipv4.address=10.98.4.1/24 ipv4.nat=true \
    ipv6.address=none dns.mode=none
incus launch images:ubuntu/24.04/cloud "$BUILD_CTR" --network "$BUILD_NET"
incus exec "$BUILD_CTR" -- cloud-init status --wait
# The base image's package index is frozen at its daily's build time, and the
# pool keeps only current versions, so a package superseded since then 404s.
incus exec "$BUILD_CTR" -- apt-get update
incus exec "$BUILD_CTR" -- apt-get install -y ldap-utils
# chrony serves site time (digital.md §1.3). Installing it masks
# systemd-timesyncd, so the two do not contend for the clock.
incus exec "$BUILD_CTR" -- apt-get install -y chrony

# Pre-seed debconf and install slapd non-interactively
incus exec "$BUILD_CTR" -- bash -c '
echo "slapd slapd/password1 password {{ world.identities.ldap_admin.password }}" | debconf-set-selections
echo "slapd slapd/password2 password {{ world.identities.ldap_admin.password }}" | debconf-set-selections
echo "slapd slapd/domain string ravensport.local" | debconf-set-selections
echo "slapd shared/organization string Ravensport" | debconf-set-selections
echo "slapd slapd/backend string MDB" | debconf-set-selections
echo "slapd slapd/purge_database boolean false" | debconf-set-selections
echo "slapd slapd/move_old_database boolean true" | debconf-set-selections
DEBIAN_FRONTEND=noninteractive apt-get install -y slapd'

# Push LDIF and seed directory. Addressed via the local ldapi:/// socket, not
# ldap://localhost: SLAPD_SERVICES is set to ldaps-only below, so a plaintext
# TCP bind would no longer be available even for this build-time step.
incus file push build/ldif/corp-it.ldif "$BUILD_CTR/tmp/corp-it.ldif"
incus exec "$BUILD_CTR" -- bash -c '
BASE_DN="dc=ravensport,dc=local"
ADMIN_DN="cn=admin,${BASE_DN}"
ADMIN_PW="{{ world.identities.ldap_admin.password }}"
for i in $(seq 1 30); do
    ldapsearch -x -H ldapi:/// \
        -D "${ADMIN_DN}" -w "${ADMIN_PW}" \
        -b "${BASE_DN}" "(objectClass=*)" dn >/dev/null 2>&1 && break
    sleep 0.5
done
ldapadd -x -H ldapi:/// -D "${ADMIN_DN}" -w "${ADMIN_PW}" \
    -f /tmp/corp-it.ldif
rm /tmp/corp-it.ldif'

# ── Directory TLS material and LDAPS-only listener (corp-it.md §5/§6) ────────
# slapd is the only TLS-terminating service on this host, so there is one
# keypair to install, unlike hist-01/hist-dmz-01's multi-service shared one.
incus exec "$BUILD_CTR" -- mkdir -p /etc/ldap/tls
incus file push build/tls/corp-it/cert.pem "$BUILD_CTR/etc/ldap/tls/cert.pem"
incus file push build/tls/corp-it/key.pem "$BUILD_CTR/etc/ldap/tls/key.pem"
incus exec "$BUILD_CTR" -- chown openldap:openldap /etc/ldap/tls/cert.pem /etc/ldap/tls/key.pem
incus exec "$BUILD_CTR" -- chmod 644 /etc/ldap/tls/cert.pem
incus exec "$BUILD_CTR" -- chmod 600 /etc/ldap/tls/key.pem

# cn=config is modified live, via the local ldapi:/// socket with SASL
# EXTERNAL (root on the socket's peer credentials authenticates as the
# directory's own super-user) — the standard Debian/Ubuntu route, and the
# only one available: there is no separate config-database password.
incus exec "$BUILD_CTR" -- tee /tmp/tls.ldif > /dev/null <<'LDIF'
dn: cn=config
changetype: modify
replace: olcTLSCertificateFile
olcTLSCertificateFile: /etc/ldap/tls/cert.pem
-
replace: olcTLSCertificateKeyFile
olcTLSCertificateKeyFile: /etc/ldap/tls/key.pem
-
replace: olcTLSCACertificateFile
olcTLSCACertificateFile: /etc/ssl/certs/ca-certificates.crt
LDIF
incus exec "$BUILD_CTR" -- ldapmodify -Y EXTERNAL -H ldapi:/// -f /tmp/tls.ldif
incus exec "$BUILD_CTR" -- rm /tmp/tls.ldif

# No plaintext LDAP listener remains configured (corp-it.md §3) — only
# ldaps:/// and the local ldapi:/// socket.
incus exec "$BUILD_CTR" -- sed -i \
    's|^SLAPD_SERVICES=.*|SLAPD_SERVICES="ldaps:/// ldapi:///"|' \
    /etc/default/slapd

incus exec "$BUILD_CTR" -- systemctl stop slapd

incus file push --mode 0600 build/network-config/corp-it.yaml \
    "$BUILD_CTR/etc/netplan/99-ravensport.yaml"
incus exec "$BUILD_CTR" -- rm -f /etc/netplan/50-cloud-init.yaml
# Generate systemd-networkd .network unit files by parsing the netplan YAML
# directly.  Using the netplan CLI's generator is unreliable: it targets
# /run/systemd/network/ (a tmpfs) which is not preserved in the published
# image, and renderer detection may select NetworkManager rather than networkd.
incus exec "$BUILD_CTR" -- tee /tmp/gen-networkd.py > /dev/null << 'PYEOF'
import yaml, os
os.makedirs("/etc/systemd/network", exist_ok=True)
with open("/etc/netplan/99-ravensport.yaml") as f:
    cfg = yaml.safe_load(f)
for iface, spec in (cfg.get("ethernets") or {}).items():
    lines = ["[Match]", f"Name={iface}", "", "[Network]"]
    for addr in (spec.get("addresses") or []):
        lines.append(f"Address={addr}")
    routes = spec.get("routes") or []
    for r in routes:
        if str(r.get("to")) == "default":
            lines.append(f"Gateway={r['via']}")
    for dns in ((spec.get("nameservers") or {}).get("addresses") or []):
        lines.append(f"DNS={dns}")
    for r in routes:
        if str(r.get("to")) != "default":
            lines += ["", "[Route]", f"Destination={r['to']}", f"Gateway={r['via']}"]
    path = f"/etc/systemd/network/10-ravensport-{iface}.network"
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    print(f"Wrote {path}")
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/gen-networkd.py
incus exec "$BUILD_CTR" -- rm /tmp/gen-networkd.py
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts"
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts.ravensport"
incus file push build/chrony/{{ node_name }}.conf "$BUILD_CTR/etc/chrony/chrony.conf"

incus exec "$BUILD_CTR" -- tee /etc/systemd/system/ravensport-hosts.service > /dev/null <<'UNIT'
[Unit]
Description=Restore /etc/hosts from Ravensport canonical source
DefaultDependencies=no
Before=network-pre.target sysinit.target
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/bin/cp /etc/hosts.ravensport /etc/hosts
RemainAfterExit=yes
[Install]
WantedBy=sysinit.target
UNIT
{% include "_trust_ca.sh.j2" %}
{% include "_wazuh-agent.sh.j2" %}
incus exec "$BUILD_CTR" -- systemctl daemon-reload
incus exec "$BUILD_CTR" -- systemctl enable slapd ravensport-hosts.service systemd-networkd chrony
{% include "_no-external-services.sh.j2" %}
# Purge cloud-init — remove the package and residue rather than disabling it,
# so the tree cannot be re-created on the next boot.
incus exec "$BUILD_CTR" -- cloud-init clean --logs --seed
incus exec "$BUILD_CTR" -- apt-get purge -y cloud-init
incus exec "$BUILD_CTR" -- rm -rf /var/lib/cloud /etc/cloud
{% include "_clear-build-logs.sh.j2" %}

incus stop "$BUILD_CTR"
incus image delete "$IMAGE_ALIAS" 2>/dev/null || true
incus publish "$BUILD_CTR" --alias "$IMAGE_ALIAS"
incus image set-property "$IMAGE_ALIAS" "ravensport.input-hash" "$current_hash"
echo "==> $IMAGE_ALIAS ready"
