#!/usr/bin/env bash
# Build image for {{ node_name }}. Generated by render.py.
#
# The reconciliation workstation (recon.md): a desktop with a remote desktop
# service, a terminal, curl, xclip, and a pinned browser. It runs no service of
# its own and holds no records — an audit retrieves the month's record from the
# log-server replica with curl through Grafana's datasource proxy and pipes it
# onto the clipboard, and nothing comes to rest on disk
#
# The browser is installed because an office workstation has one; it is not on
# the audit path.
#
# This is the only host in the fleet with an interactive login. Every other
# account in the environment either runs a daemon or lives in an application's
# own user store.
set -euo pipefail
cd "$(dirname "$0")/../.."

if [ ! -f build/tls/{{ node_name }}/cert.pem ] || [ ! -f build/tls/{{ node_name }}/key.pem ]; then
    echo "ERROR: CA-signed certificate not found at build/tls/{{ node_name }}/ — run make build-ca first." >&2
    exit 1
fi
# The two halves have two producers: render.py rewrites key.pem on every render,
# while cert.pem is build-ca.sh's and is preserved across a render. A render
# following a changed crypto.password_salt_seed or crypto.ca_not_before
# therefore leaves a new key beside a certificate signed from the previous one.
# xrdp would start on that pair and fail each handshake when a client arrives;
# comparing the moduli is the only check that distinguishes the two.
if [ "$(openssl x509 -noout -modulus -in build/tls/{{ node_name }}/cert.pem)" \
  != "$(openssl rsa -noout -modulus -in build/tls/{{ node_name }}/key.pem)" ]; then
    echo "ERROR: build/tls/{{ node_name }}/cert.pem was not signed for key.pem — the two are from different renders. Run make build-ca first." >&2
    exit 1
fi

{% include "_artefacts.sh.j2" %}

# Fetched before the input hash below reads it, and before any container exists
# to clean up if the download fails.
FIREFOX_TARBALL=$(fetch_artefact firefox)

IMAGE_ALIAS="ravensport/{{ node_name }}:latest"
BUILD_CTR="rpbuild{{ node_name | replace('-', '') }}-$$"
_RND=$(printf '%04x' $((RANDOM)))
BUILD_NET="rpb{{ (node_name | replace('-', ''))[:8] }}${_RND}"

FIREFOX_DIR="/opt/firefox"

cleanup() {
    incus delete -f "$BUILD_CTR" 2>/dev/null || true
    incus network delete "$BUILD_NET" 2>/dev/null || true
}
trap cleanup EXIT

current_hash=$(sha256sum \
    build/node-build/{{ node_name }}.sh \
    build/network-config/{{ node_name }}.yaml \
    build/hosts/{{ node_name }} \
    build/chrony/{{ node_name }}.conf \
    build/sssd/{{ node_name }}.conf \
    build/ca/ca.pem \
    build/tls/{{ node_name }}/cert.pem \
    build/tls/{{ node_name }}/key.pem \
    "$FIREFOX_TARBALL" \
    build/siem/{{ node_name }}.key \
    build-scripts/keys/wazuh-repo.gpg \
    build/nftables/{{ node_name }}.nft \
    build-scripts/ulogd.conf \
  | sha256sum | cut -d' ' -f1)
stored_hash=$(incus image get-property "$IMAGE_ALIAS" "ravensport.input-hash" 2>/dev/null || echo "")
if [ "$current_hash" = "$stored_hash" ]; then
    echo "  {{ node_name }}: inputs unchanged, skipping"; exit 0
fi

echo "==> Building $IMAGE_ALIAS"
incus network create "$BUILD_NET" \
    ipv4.address=10.98.5.1/24 ipv4.nat=true \
    ipv6.address=none dns.mode=none
incus launch images:ubuntu/24.04/cloud "$BUILD_CTR" --network "$BUILD_NET"
incus exec "$BUILD_CTR" -- cloud-init status --wait

# ── Packages (recon.md §2) ────────────────────────────────────────────────────
# Named explicitly with --no-install-recommends, consistent with fleet practice.
# x11-xkb-utils supplies setxkbmap, which §5.2 makes load-bearing: the actor
# sends scancodes, so the layout decides what they type. xz-utils unpacks the
# browser tarball.
#
# xfce4-terminal is a recommendation of the xfce4 metapackage, so
# --no-install-recommends drops it unless it is named here.
incus exec "$BUILD_CTR" -- apt-get update
#
# curl and xclip explicitly named as needed: curl is the audit's query client
# and xclip is what carries a retrieved export onto the CLIPBOARD selection,
# which recon.md §2 makes the only route by which a record reaches the actor.
incus exec "$BUILD_CTR" -- apt-get install -y --no-install-recommends \
    xrdp xorgxrdp \
    xfce4 xfce4-session xfce4-terminal dbus-x11 \
    x11-xserver-utils x11-xkb-utils \
    ca-certificates xz-utils \
    curl xclip
incus exec "$BUILD_CTR" -- apt-get install -y chrony

# Firefox links against these at runtime (recon.md §2.1). A missing one presents
# as a browser that exits immediately rather than as a build failure, which is
# why the browser is started below rather than trusted to the package list.
incus exec "$BUILD_CTR" -- apt-get install -y --no-install-recommends \
    libgtk-3-0t64 libdbus-glib-1-2 libasound2t64 libxt6t64 fonts-liberation

# ── Browser (recon.md §6.2) ───────────────────────────────────────────────────
# A pinned, checksummed Extended Support Release tarball. Ubuntu's `firefox`
# package is a transitional wrapper around snapd, which does not work in an
# unprivileged container; Mozilla's package repository would be the only
# unpinned build input in the fleet.
incus file push "$FIREFOX_TARBALL" "$BUILD_CTR/tmp/firefox.tar.xz"
incus exec "$BUILD_CTR" -- tar -xJf /tmp/firefox.tar.xz -C /opt
incus exec "$BUILD_CTR" -- rm -f /tmp/firefox.tar.xz
incus exec "$BUILD_CTR" -- ln -sf "$FIREFOX_DIR/firefox" /usr/local/bin/firefox

# ── Enterprise policy (recon.md §6.3) ─────────────────────────────────────────
# Written to both locations a Firefox reads. Which one a tarball install uses is
# an open question in §6.3 — a packaged build reads /etc/firefox/policies/, and
# a tarball install may read <install-dir>/distribution/ instead. A policy file
# in the location the browser does not read fails silently: the browser starts
# normally and none of the settings apply. Writing both removes the question
# from the build; the deployment tests assert the effect rather than the file.
incus exec "$BUILD_CTR" -- mkdir -p /etc/firefox/policies "$FIREFOX_DIR/distribution"
incus exec "$BUILD_CTR" -- tee /etc/firefox/policies/policies.json > /dev/null <<'POLICY'
{
  "policies": {
    "DisableAppUpdate": true,
    "DisableTelemetry": true,
    "DisableFirefoxStudies": true,
    "DisablePocket": true,
    "DisableFirefoxAccounts": true,
    "DisableProfileImport": true,
    "DisableFormHistory": true,
    "DisablePasswordReveal": true,
    "PasswordManagerEnabled": false,
    "OfferToSaveLogins": false,
    "DontCheckDefaultBrowser": true,
    "NoDefaultBookmarks": true,
    "SkipTermsOfUse": true,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "Preferences": {
      "devtools.jsonview.enabled":                                  { "Value": false, "Status": "locked" },
      "browser.cache.disk.enable":                                  { "Value": false, "Status": "locked" },
      "browser.cache.memory.enable":                                { "Value": false, "Status": "locked" },
      "browser.aboutwelcome.enabled":                               { "Value": false, "Status": "locked" },
      "browser.startup.homepage_override.mstone":                   { "Value": "ignore", "Status": "locked" },
      "datareporting.policy.dataSubmissionPolicyBypassNotification": { "Value": true, "Status": "locked" }
    }
  }
}
POLICY
incus exec "$BUILD_CTR" -- cp /etc/firefox/policies/policies.json \
    "$FIREFOX_DIR/distribution/policies.json"

# ── Applications menu entry (recon.md §5.3) ───────────────────────────────────
incus exec "$BUILD_CTR" -- tee /usr/share/applications/firefox.desktop > /dev/null <<ENTRY
[Desktop Entry]
Version=1.0
Type=Application
Name=Firefox
GenericName=Web Browser
Comment=Browse the World Wide Web
Exec=$FIREFOX_DIR/firefox %u
Icon=$FIREFOX_DIR/browser/chrome/icons/default/default128.png
Terminal=false
StartupNotify=true
StartupWMClass=firefox
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
ENTRY

# The icon path is part of the artefact rather than of this build
incus exec "$BUILD_CTR" -- bash -c "
test -f '$FIREFOX_DIR/browser/chrome/icons/default/default128.png' || {
    echo 'ERROR: the icon named by firefox.desktop is not in the tarball.' >&2
    echo '       The pinned release has moved it; correct the entry and the' >&2
    echo '       recon.md §5.3 record of it. Icons present:' >&2
    ls -1 '$FIREFOX_DIR/browser/chrome/icons/default/' >&2 || true
    exit 1
}"

# The browser runs. Covers §2.1's runtime dependencies through their observable
# consequence — a missing library exits immediately rather than failing the
# install. The profile is a throwaway under /tmp and is removed below: the image
# creates no browser profile. §6.4 installs the root into the
# system store only.
# Whether the policy is in *effect* is asserted by the deployment tests against
# a real session, not here: a headless start cannot render about:policies to
# read it back.
incus exec "$BUILD_CTR" -- bash -c "
set -e
export HOME=/tmp/ffcheck
mkdir -p \$HOME
timeout 60 firefox --headless --screenshot /tmp/ffcheck/shot.png about:blank >/dev/null 2>&1
test -s /tmp/ffcheck/shot.png || {
    echo 'ERROR: Firefox did not start. A missing runtime dependency exits' >&2
    echo '       immediately rather than failing the install (recon.md §2.1).' >&2
    firefox --version >&2 || true
    exit 1
}
firefox --version"
incus exec "$BUILD_CTR" -- rm -rf /tmp/ffcheck

# ── Directory client (recon.md §7.1) ──────────────────────────────────────────
# The workstation login authenticates against the directory on corp-it. 
# No local account created
#
# sssd searches anonymously and binds as the authenticating user, so the
# workstation carries no service credential either. The rendered configuration
# holds the directory's address and where to search in it, and nothing else.
incus exec "$BUILD_CTR" -- apt-get install -y --no-install-recommends \
    sssd-ldap libnss-sss libpam-sss
incus file push --mode 0600 build/sssd/{{ node_name }}.conf \
    "$BUILD_CTR/etc/sssd/sssd.conf"
# sssd refuses to start on a configuration group- or world-readable, and reports
# it only to the journal, so the mode is set rather than assumed from the push.
incus exec "$BUILD_CTR" -- chown root:root /etc/sssd/sssd.conf
incus exec "$BUILD_CTR" -- chmod 0600 /etc/sssd/sssd.conf

# Name service and authentication both consult the directory. nsswitch is
# edited rather than trusted: a host that authenticates a user it cannot resolve
# reaches a session with no home directory, no group and no name for its user.
#
# Appended only where absent. `libnss-sss`'s post-install adds `sss` itself, so
# an unconditional append yields `passwd: files systemd sss sss` — harmless at
# lookup time, but it misreports how the file was configured.
incus exec "$BUILD_CTR" -- bash -c '
for db in passwd group shadow; do
    grep -qE "^${db}:.*\bsss\b" /etc/nsswitch.conf \
        || sed -i "/^${db}:/ s/\$/ sss/" /etc/nsswitch.conf
done'
incus exec "$BUILD_CTR" -- bash -c "
dupes=\$(grep -E '^(passwd|group|shadow):' /etc/nsswitch.conf | grep -c 'sss.*sss' || true)
test \"\$dupes\" -eq 0 || {
    echo 'ERROR: a name-service database names sss more than once:' >&2
    grep -E '^(passwd|group|shadow):' /etc/nsswitch.conf >&2
    exit 1
}"
incus exec "$BUILD_CTR" -- pam-auth-update --enable sss --enable mkhomedir
incus exec "$BUILD_CTR" -- bash -c "
grep -q 'pam_mkhomedir' /etc/pam.d/common-session || {
    echo 'ERROR: pam_mkhomedir is not in the session stack. A directory account' >&2
    echo '       has no home directory until one is created at first login, so' >&2
    echo '       the session would start without ~/.xsession and reach no' >&2
    echo '       desktop (recon.md §5).' >&2
    exit 1
}"

# ── Terminal helper (recon.md §5.4) ───────────────────────────────────────────
# Ensure a terminal is opened when `Ctrl+Alt+T` is run vs an application chooser
# Application chooser would take the focus and absorb all subsequent keystrokes
#
# Into /etc/skel, not a home directory: the account is a directory one, so none
# exists until pam_mkhomedir creates it at first login and populates it from
# here — the preference then arrives with the home directory.
XFCE_HELPER_ID="xfce4-terminal"
incus exec "$BUILD_CTR" -- bash -c "
test -f '/usr/share/xfce4/helpers/$XFCE_HELPER_ID.desktop' || {
    echo 'ERROR: no helper definition for $XFCE_HELPER_ID, so the preference' >&2
    echo '       written below names an identifier exo-open cannot resolve and' >&2
    echo '       the chooser appears regardless. Helpers present:' >&2
    ls -1 /usr/share/xfce4/helpers/ >&2 || true
    exit 1
}"
incus exec "$BUILD_CTR" -- mkdir -p /etc/skel/.config/xfce4
incus exec "$BUILD_CTR" -- tee /etc/skel/.config/xfce4/helpers.rc \
    > /dev/null <<HELPERS
TerminalEmulator=$XFCE_HELPER_ID
HELPERS

# ── Shell history (recon.md §7.2) ─────────────────────────────────────────────
# Each command is appended to `bash` history once it has been executed, compared
# to exit of the shell, so open terminals leave some residue. recon.md §7.2
#
# /etc/bash.bashrc rather than a /etc/profile.d/ drop-in, so the terminal of §5.4
# spawns an interactive non-login shell, which never reads a profile
incus exec "$BUILD_CTR" -- tee -a /etc/bash.bashrc > /dev/null <<'BASHRC'

PROMPT_COMMAND='history -a'
BASHRC


# ── Desktop session (recon.md §5) ─────────────────────────────────────────────
# xrdp's startwm.sh sources ~/.xsession, so the session is selected per user.
# Nothing is autostarted. 
# The narrative describes a user opening an application rather than a
# workstation permanently pointed at one (§5).
#
# setxkbmap pins the layout as `gb`. The actor injects PS/2 Set 1 scancodes, not
# characters, so the layout decides what they type; a change here would present
# as a rejected credential rather than as a configuration fault (§5.2).
#
# Into /etc/skel for the same reason as the terminal helper above: the account
# is a directory one and its home directory is created at first login.
incus exec "$BUILD_CTR" -- tee /etc/skel/.xsession > /dev/null <<'XSESSION'
#!/bin/sh
export XDG_SESSION_DESKTOP=xfce
export XDG_CURRENT_DESKTOP=XFCE
setxkbmap gb
exec startxfce4
XSESSION
incus exec "$BUILD_CTR" -- chmod 0755 /etc/skel/.xsession

# ── Remote access (recon.md §4) ───────────────────────────────────────────────
# The security layer is forced to TLS. Under xrdp's default `negotiate` the
# server falls back to the legacy standard Remote Desktop Protocol layer, which
# a client requiring enhanced security refuses.
incus exec "$BUILD_CTR" -- sed -i 's/^security_layer=.*/security_layer=tls/' /etc/xrdp/xrdp.ini
incus exec "$BUILD_CTR" -- bash -c "
grep -q '^security_layer=tls' /etc/xrdp/xrdp.ini || {
    echo 'ERROR: security_layer was not set to tls in /etc/xrdp/xrdp.ini.' >&2
    echo '       The substitution matched nothing, so the packaged default' >&2
    echo '       stands and the negotiated layer will be the legacy one.' >&2
    grep -n '^security_layer' /etc/xrdp/xrdp.ini >&2 || true
    exit 1
}"

# The certificate is the internal certificate authority's leaf for recon-01
# rather than the distribution's self-signed pair, which the packaged empty
# `certificate=` and `key_file=` select; the reconciliation user verifies it
# against the deployment's root and refuses anything else. The key is the
# `xrdp` user's alone: without read access the server reports
# SSL_CERT_NOT_ON_SERVER when a client arrives — a failure invisible at build
# time, which is why it is also asserted from a connection in the deployment
# tests. No `ssl-cert` group membership is given, since no key under
# /etc/ssl/private/ is presented.
incus exec "$BUILD_CTR" -- mkdir -p /etc/xrdp/tls
incus file push build/tls/{{ node_name }}/cert.pem "$BUILD_CTR/etc/xrdp/tls/recon-01.pem"
incus file push build/tls/{{ node_name }}/key.pem "$BUILD_CTR/etc/xrdp/tls/recon-01.key"
incus exec "$BUILD_CTR" -- chown root:root /etc/xrdp/tls/recon-01.pem
incus exec "$BUILD_CTR" -- chmod 644 /etc/xrdp/tls/recon-01.pem
incus exec "$BUILD_CTR" -- chown xrdp /etc/xrdp/tls/recon-01.key
incus exec "$BUILD_CTR" -- chmod 600 /etc/xrdp/tls/recon-01.key
incus exec "$BUILD_CTR" -- sed -i 's|^certificate=.*|certificate=/etc/xrdp/tls/recon-01.pem|' /etc/xrdp/xrdp.ini
incus exec "$BUILD_CTR" -- sed -i 's|^key_file=.*|key_file=/etc/xrdp/tls/recon-01.key|' /etc/xrdp/xrdp.ini
incus exec "$BUILD_CTR" -- bash -c "
grep -q '^certificate=/etc/xrdp/tls/recon-01.pem' /etc/xrdp/xrdp.ini \
  && grep -q '^key_file=/etc/xrdp/tls/recon-01.key' /etc/xrdp/xrdp.ini || {
    echo 'ERROR: certificate= or key_file= was not set in /etc/xrdp/xrdp.ini.' >&2
    echo '       The substitution matched nothing, so the packaged default' >&2
    echo '       stands and xrdp presents the self-signed pair.' >&2
    grep -nE '^(certificate|key_file)=' /etc/xrdp/xrdp.ini >&2 || true
    exit 1
}"

incus file push --mode 0600 build/network-config/{{ node_name }}.yaml \
    "$BUILD_CTR/etc/netplan/99-ravensport.yaml"
incus exec "$BUILD_CTR" -- rm -f /etc/netplan/50-cloud-init.yaml
# Generate systemd-networkd .network unit files by parsing the netplan YAML
# directly.  Using the netplan CLI's generator is unreliable: it targets
# /run/systemd/network/ (a tmpfs) which is not preserved in the published
# image, and renderer detection may select NetworkManager rather than networkd.
incus exec "$BUILD_CTR" -- tee /tmp/gen-networkd.py > /dev/null << 'PYEOF'
import yaml, os
os.makedirs("/etc/systemd/network", exist_ok=True)
with open("/etc/netplan/99-ravensport.yaml") as f:
    cfg = yaml.safe_load(f)
for iface, spec in (cfg.get("ethernets") or {}).items():
    lines = ["[Match]", f"Name={iface}", "", "[Network]"]
    for addr in (spec.get("addresses") or []):
        lines.append(f"Address={addr}")
    routes = spec.get("routes") or []
    for r in routes:
        if str(r.get("to")) == "default":
            lines.append(f"Gateway={r['via']}")
    for dns in ((spec.get("nameservers") or {}).get("addresses") or []):
        lines.append(f"DNS={dns}")
    for r in routes:
        if str(r.get("to")) != "default":
            lines += ["", "[Route]", f"Destination={r['to']}", f"Gateway={r['via']}"]
    path = f"/etc/systemd/network/10-ravensport-{iface}.network"
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    print(f"Wrote {path}")
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/gen-networkd.py
incus exec "$BUILD_CTR" -- rm /tmp/gen-networkd.py
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts"
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts.ravensport"
incus file push build/chrony/{{ node_name }}.conf "$BUILD_CTR/etc/chrony/chrony.conf"

incus exec "$BUILD_CTR" -- tee /etc/systemd/system/ravensport-hosts.service > /dev/null <<'UNIT'
[Unit]
Description=Restore /etc/hosts from Ravensport canonical source
DefaultDependencies=no
Before=network-pre.target sysinit.target
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/bin/cp /etc/hosts.ravensport /etc/hosts
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
UNIT
incus exec "$BUILD_CTR" -- systemctl daemon-reload
incus exec "$BUILD_CTR" -- systemctl enable xrdp xrdp-sesman sssd ravensport-hosts.service systemd-networkd chrony
# The trust anchor of recon.md §6.4. Installed into the system store, which is
# what `curl` verifies the log-server replica against on the audit path of
# §6.1 — the reason §6.1 rejects `--insecure`. Firefox keeps its own store and
# is not configured here: §6.4 leaves the browser out, as it is not on the
# audit path.
{% include "_trust_ca.sh.j2" %}
{% include "_wazuh-agent.sh.j2" %}
# The directory client's domain log (siem.md §3, §8.2, recon.md §7.1.1): not
# carried by the journal, so it is a file input alongside the agent's default
# journald collection. Readable without a permission change: the agent's log
# collector runs as root, and the file (0600, root:root) is already root-readable.
incus exec "$BUILD_CTR" -- tee /tmp/patch_agent_localfile.py > /dev/null << 'PYEOF'
PATH = "/var/ossec/etc/ossec.conf"
with open(PATH) as f:
    text = f.read()
text = text.replace(
    "</ossec_config>",
    "  <localfile>\n"
    "    <log_format>syslog</log_format>\n"
    "    <location>/var/log/sssd/sssd_ravensport.log</location>\n"
    "  </localfile>\n"
    "</ossec_config>",
)
with open(PATH, "w") as f:
    f.write(text)
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/patch_agent_localfile.py
incus exec "$BUILD_CTR" -- rm /tmp/patch_agent_localfile.py
{% include "_no-external-services.sh.j2" %}
# Purge cloud-init — remove the package and residue rather than disabling it,
# so the tree cannot be re-created on the next boot.
incus exec "$BUILD_CTR" -- cloud-init clean --logs --seed
incus exec "$BUILD_CTR" -- apt-get purge -y cloud-init
incus exec "$BUILD_CTR" -- rm -rf /var/lib/cloud /etc/cloud
{% include "_clear-build-logs.sh.j2" %}

incus stop "$BUILD_CTR"
incus image delete "$IMAGE_ALIAS" 2>/dev/null || true
incus publish "$BUILD_CTR" --alias "$IMAGE_ALIAS"
incus image set-property "$IMAGE_ALIAS" "ravensport.input-hash" "$current_hash"
echo "==> $IMAGE_ALIAS ready"
