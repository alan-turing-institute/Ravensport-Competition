#!/usr/bin/env bash
# Build image for {{ node_name }}. Generated by render.py.
#
# The adversary is an attack-launch host that models a machine entirely outside
# RavensPort (adversary.md). Only its two NICs sit inside RavensPort broadcast
# domains, as the footholds the modelled attacks use; the host itself is not part
# of the asset. It therefore carries none of the fleet's internal material: it
# does not trust or hold the internal CA root (contrast _trust_ca.sh.j2, included
# by every asset node), runs no time client, and installs no service. Its image
# holds only the static network configuration, a loopback-only /etc/hosts, the
# reconnaissance, capture, and directory utilities the attack phase depends on,
# and every attack chain's binary with the catalogue chains.json in /root
# (adversary.md §2).
set -euo pipefail
cd "$(dirname "$0")/../.."

IMAGE_ALIAS="ravensport/{{ node_name }}:latest"
BUILD_CTR="rpbuild{{ node_name | replace('-', '') }}-$$"
_RND=$(printf '%04x' $((RANDOM)))
BUILD_NET="rpb{{ (node_name | replace('-', ''))[:8] }}${_RND}"

cleanup() {
    incus delete -f "$BUILD_CTR" 2>/dev/null || true
    incus network delete "$BUILD_NET" 2>/dev/null || true
}
trap cleanup EXIT

# Every attack chain's binary, and the catalogue chains.json beside them, as
# `make up` populates them on Linux before the image is built — by building them
# from source, or, in a source-free release, by staging the prebuilt set. The
# SHA256SUMS and SOURCE_SHA256 that a prebuilt set leaves beside them are the
# episode runner's, not the image's, so they are excluded here. A binary of a
# mock build, `make build-attacks-mock`, takes fixed facts in place of the scan
# of the IT segment, so the image takes none.
ATTACK_DIST=../attack-chains/dist
binaries=$(find "$ATTACK_DIST" -maxdepth 1 -type f ! -name chains.json ! -name SHA256SUMS ! -name SOURCE_SHA256 2>/dev/null | sort || true)
if [ -z "$binaries" ] || [ ! -f "$ATTACK_DIST/chains.json" ]; then
    echo "$ATTACK_DIST holds no binary or no chains.json: run 'make up' (or 'make build-attacks') first" >&2
    exit 1
fi
for binary in $binaries; do
    case "$(basename "$binary")" in
        mock-scan-test__*)
            echo "$binary is from a mock build: run 'make build-attacks'" >&2
            exit 1 ;;
    esac
    file "$binary" | grep -q ELF || {
        echo "$binary is not a Linux ELF binary: run 'make build-attacks' on Linux" >&2
        exit 1
    }
    # The emitter writes only hardened, fully stripped binaries; refuse to bake a
    # non-stripped one. `, stripped` matches that field only, not `, not
    # stripped`, and -b drops the filename.
    file -b "$binary" | grep -q ', stripped' || {
        echo "$binary is not stripped: refusing to bake a non-hardened attack binary" >&2
        exit 1
    }
done

# No build/ca/ca.pem in the hash: the adversary holds no CA material, so the
# root certificate is not an input to its build.
current_hash=$(sha256sum \
    build/node-build/{{ node_name }}.sh \
    build/network-config/{{ node_name }}.yaml \
    build/hosts/{{ node_name }} \
    $binaries \
    "$ATTACK_DIST/chains.json" \
  | sha256sum | cut -d' ' -f1)
stored_hash=$(incus image get-property "$IMAGE_ALIAS" "ravensport.input-hash" 2>/dev/null || echo "")
if [ "$current_hash" = "$stored_hash" ]; then
    echo "  {{ node_name }}: inputs unchanged, skipping"; exit 0
fi

echo "==> Building $IMAGE_ALIAS"
incus network create "$BUILD_NET" \
    ipv4.address=10.98.6.1/24 ipv4.nat=true \
    ipv6.address=none dns.mode=none
incus launch images:ubuntu/24.04/cloud "$BUILD_CTR" --network "$BUILD_NET"
incus exec "$BUILD_CTR" -- cloud-init status --wait
# The base image's package index is frozen at its daily's build time, and the
# pool keeps only current versions, so a package superseded since then 404s.
incus exec "$BUILD_CTR" -- apt-get update
# Reconnaissance, capture, and directory tooling the attack phase depends on
# (adversary.md §2): tcpdump captures a segment, nmap discovers hosts and
# services, and ldap-utils enumerates and acts on the LDAP identity provider.
incus exec "$BUILD_CTR" -- apt-get install -y tcpdump nmap ldap-utils

incus file push --mode 0600 build/network-config/{{ node_name }}.yaml \
    "$BUILD_CTR/etc/netplan/99-ravensport.yaml"
incus exec "$BUILD_CTR" -- rm -f /etc/netplan/50-cloud-init.yaml
# Generate systemd-networkd .network unit files by parsing the netplan YAML
# directly.  Using the netplan CLI's generator is unreliable: it targets
# /run/systemd/network/ (a tmpfs) which is not preserved in the published
# image, and renderer detection may select NetworkManager rather than networkd.
incus exec "$BUILD_CTR" -- tee /tmp/gen-networkd.py > /dev/null << 'PYEOF'
import yaml, os
os.makedirs("/etc/systemd/network", exist_ok=True)
with open("/etc/netplan/99-ravensport.yaml") as f:
    cfg = yaml.safe_load(f)
for iface, spec in (cfg.get("ethernets") or {}).items():
    lines = ["[Match]", f"Name={iface}", ""]
    # A runtime-activated NIC (activation-mode: off) boots down and addressless;
    # an attack stage brings it up and binds its address for the stage's duration
    # (adversary.md). ActivationPolicy=down keeps it down at boot while still
    # allowing a later manual `ip link set <iface> up`.
    if spec.get("activation-mode") == "off":
        lines += ["[Link]", "ActivationPolicy=down", ""]
    lines += ["[Network]"]
    for addr in (spec.get("addresses") or []):
        lines.append(f"Address={addr}")
    routes = spec.get("routes") or []
    for r in routes:
        if str(r.get("to")) == "default":
            lines.append(f"Gateway={r['via']}")
    for dns in ((spec.get("nameservers") or {}).get("addresses") or []):
        lines.append(f"DNS={dns}")
    for r in routes:
        if str(r.get("to")) != "default":
            lines += ["", "[Route]", f"Destination={r['to']}", f"Gateway={r['via']}"]
    path = f"/etc/systemd/network/10-ravensport-{iface}.network"
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    print(f"Wrote {path}")
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/gen-networkd.py
incus exec "$BUILD_CTR" -- rm /tmp/gen-networkd.py
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts"
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts.ravensport"

incus exec "$BUILD_CTR" -- tee /etc/systemd/system/ravensport-hosts.service > /dev/null <<'UNIT'
[Unit]
Description=Restore /etc/hosts from Ravensport canonical source
DefaultDependencies=no
Before=network-pre.target sysinit.target
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/bin/cp /etc/hosts.ravensport /etc/hosts
RemainAfterExit=yes
[Install]
WantedBy=sysinit.target
UNIT
incus exec "$BUILD_CTR" -- systemctl daemon-reload
incus exec "$BUILD_CTR" -- systemctl enable ravensport-hosts.service systemd-networkd
incus exec "$BUILD_CTR" -- bash -c 'echo ok > /run/ready'
# Purge cloud-init — remove the package and residue rather than disabling it,
# so the tree cannot be re-created on the next boot.
incus exec "$BUILD_CTR" -- cloud-init clean --logs --seed
incus exec "$BUILD_CTR" -- apt-get purge -y cloud-init
incus exec "$BUILD_CTR" -- rm -rf /var/lib/cloud /etc/cloud

{% include "_no-external-services.sh.j2" %}

# Every attack chain's binary, executable, and the catalogue beside them, in
# /root (adversary.md §2).
for binary in $binaries; do
    incus file push --mode 0755 "$binary" "$BUILD_CTR/root/$(basename "$binary")"
done
incus file push --mode 0644 "$ATTACK_DIST/chains.json" "$BUILD_CTR/root/chains.json"
{% include "_clear-build-logs.sh.j2" %}
incus stop "$BUILD_CTR"
incus image delete "$IMAGE_ALIAS" 2>/dev/null || true
incus publish "$BUILD_CTR" --alias "$IMAGE_ALIAS"
incus image set-property "$IMAGE_ALIAS" "ravensport.input-hash" "$current_hash"
echo "==> $IMAGE_ALIAS ready"
