#!/usr/bin/env bash
# Build image for {{ node_name }}. Generated by render.py.
set -euo pipefail
cd "$(dirname "$0")/../.."   # run from deploy/

{% set internal_cidrs = [] %}
{% for net_name, net in topology.networks.items() %}
{%   if net_name != 'vnet-ext' %}
{%     set _ = internal_cidrs.append(net.cidr) %}
{%   endif %}
{% endfor %}

{% include "_artefacts.sh.j2" %}

# Verified before the input hash below reads it, and before any container
# exists to clean up if verification fails.
ET_OPEN_TGZ=$(fetch_artefact et-open)

IMAGE_ALIAS="{{ image_name }}"
BUILD_CTR="rp-build-{{ node_name | replace('-', '') }}-$$"
_RND=$(printf '%04x' $((RANDOM)))
BUILD_NET="rpb{{ (node_name | replace('-', ''))[:8] }}${_RND}"

cleanup() {
    incus delete -f "$BUILD_CTR" 2>/dev/null || true
    incus network delete "$BUILD_NET" 2>/dev/null || true
}
trap cleanup EXIT

current_hash=$(sha256sum \
    build/node-build/{{ node_name }}.sh \
    build/nftables/{{ node_name }}.nft \
    build/network-config/{{ node_name }}.yaml \
    build/hosts/{{ node_name }} \
    build/chrony/{{ node_name }}.conf \
    build/ca/ca.pem \
    build/siem/{{ node_name }}.key \
    build-scripts/keys/wazuh-repo.gpg \
    build-scripts/ulogd.conf \
    build/suricata/{{ node_name }}.env \
    build-scripts/ravensport-boundary.rules \
    "$ET_OPEN_TGZ" \
  | sha256sum | cut -d' ' -f1)
stored_hash=$(incus image get-property "$IMAGE_ALIAS" "ravensport.input-hash" 2>/dev/null || echo "")
if [ "$current_hash" = "$stored_hash" ]; then
    echo "  {{ node_name }}: inputs unchanged, skipping"; exit 0
fi

echo "==> Building $IMAGE_ALIAS"
incus network create "$BUILD_NET" \
    ipv4.address=10.98.0.1/24 ipv4.nat=true \
    ipv6.address=none dns.mode=none
incus launch images:ubuntu/24.04/cloud "$BUILD_CTR" --network "$BUILD_NET"
incus exec "$BUILD_CTR" -- cloud-init status --wait
# The base image's package index is frozen at its daily's build time, and the
# pool keeps only current versions, so a package superseded since then 404s.
incus exec "$BUILD_CTR" -- apt-get update
incus exec "$BUILD_CTR" -- apt-get install -y nftables
incus exec "$BUILD_CTR" -- apt-get install -y chrony

incus file push build/nftables/{{ node_name }}.nft \
    "$BUILD_CTR/etc/nftables.conf"
incus exec "$BUILD_CTR" -- bash -c \
    'printf "net.ipv4.ip_forward = 1\n" > /etc/sysctl.d/99-forward.conf'
incus file push --mode 0600 build/network-config/{{ node_name }}.yaml \
    "$BUILD_CTR/etc/netplan/99-ravensport.yaml"
incus exec "$BUILD_CTR" -- rm -f /etc/netplan/50-cloud-init.yaml
# Generate systemd-networkd .network unit files by parsing the netplan YAML
# directly.  Using the netplan CLI's generator is unreliable: it targets
# /run/systemd/network/ (a tmpfs) which is not preserved in the published
# image, and renderer detection may select NetworkManager rather than networkd.
incus exec "$BUILD_CTR" -- tee /tmp/gen-networkd.py > /dev/null << 'PYEOF'
import yaml, os
os.makedirs("/etc/systemd/network", exist_ok=True)
with open("/etc/netplan/99-ravensport.yaml") as f:
    cfg = yaml.safe_load(f)
for iface, spec in (cfg.get("ethernets") or {}).items():
    lines = ["[Match]", f"Name={iface}", "", "[Network]"]
    for addr in (spec.get("addresses") or []):
        lines.append(f"Address={addr}")
    routes = spec.get("routes") or []
    for r in routes:
        if str(r.get("to")) == "default":
            lines.append(f"Gateway={r['via']}")
    for dns in ((spec.get("nameservers") or {}).get("addresses") or []):
        lines.append(f"DNS={dns}")
    for r in routes:
        if str(r.get("to")) != "default":
            lines += ["", "[Route]", f"Destination={r['to']}", f"Gateway={r['via']}"]
    path = f"/etc/systemd/network/10-ravensport-{iface}.network"
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    print(f"Wrote {path}")
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/gen-networkd.py
incus exec "$BUILD_CTR" -- rm /tmp/gen-networkd.py
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts"
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts.ravensport"
incus file push build/chrony/{{ node_name }}.conf "$BUILD_CTR/etc/chrony/chrony.conf"

incus exec "$BUILD_CTR" -- tee /etc/systemd/system/ravensport-hosts.service > /dev/null <<'UNIT'
[Unit]
Description=Restore /etc/hosts from Ravensport canonical source
DefaultDependencies=no
Before=network-pre.target sysinit.target
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/bin/cp /etc/hosts.ravensport /etc/hosts
RemainAfterExit=yes
[Install]
WantedBy=sysinit.target
UNIT
incus exec "$BUILD_CTR" -- sysctl --system
{% include "_trust_ca.sh.j2" %}
{% include "_wazuh-agent.sh.j2" %}

# ── Suricata (siem.md §5, §8.2, §8.4) ────────────────────────────────────────
# The Ubuntu 24.04 universe package is already at the pinned release line
# (7.0.3, siem.md §8.4), so no third-party repository is added.
incus exec "$BUILD_CTR" -- apt-get install -y suricata=1:7.0.3-1build3

# The Emerging Threats Open ruleset, extracted into its own directory rather
# than the packaged rules directory: the package ships its own decoder-event
# rule files there (dnp3-events.rules, modbus-events.rules, …) covering
# protocols this deployment neither enables nor references, and mixing the
# two directories would load them unintentionally.
incus file push "$ET_OPEN_TGZ" "$BUILD_CTR/tmp/et-open.tar.gz"
incus exec "$BUILD_CTR" -- mkdir -p /etc/suricata/rules/et-open
incus exec "$BUILD_CTR" -- tar -xzf /tmp/et-open.tar.gz -C /etc/suricata/rules/et-open --strip-components=1 --wildcards 'rules/*.rules'
incus exec "$BUILD_CTR" -- rm /tmp/et-open.tar.gz

# The EICAR canary signature (siem.md §5, §8.4): ET ships sid 2022938
# commented out under a relevance-based deprecation. It is the one published
# signature in this ruleset that matches the EICAR test string in a
# direction and context an external caller can construct, so it is
# re-enabled explicitly here rather than left at the published default.
incus exec "$BUILD_CTR" -- tee /tmp/enable_eicar_canary.py > /dev/null << 'PYEOF'
path = "/etc/suricata/rules/et-open/emerging-exploit.rules"
with open(path) as f:
    lines = f.readlines()
out = []
found = False
for line in lines:
    if line.startswith("#") and "sid:2022938;" in line:
        line = line[1:]
        found = True
    out.append(line)
if not found:
    raise SystemExit("sid 2022938 not found commented out in " + path)
with open(path, "w") as f:
    f.writelines(out)
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/enable_eicar_canary.py
incus exec "$BUILD_CTR" -- rm /tmp/enable_eicar_canary.py

# The RavensPort boundary rules (siem.md §5): Tank Level System protocol
# conformance on TCP 10001, and protocol conformance on the Transport Layer
# Security ports and the Network Time Protocol port.
incus file push build-scripts/ravensport-boundary.rules \
    "$BUILD_CTR/etc/suricata/rules/et-open/ravensport-boundary.rules"

# suricata.yaml, patched rather than rewritten (the packaged default's
# protocol-parser and detection-engine settings are correct as shipped):
# HOME_NET/EXTERNAL_NET to the internal zones and the external segment
# (§8.4); the ruleset directory and file list; eve.json restricted to the
# flow records of §4.2 and the inspection alerts of §5, with the matched
# payload included so a boundary alert carries the bytes that triggered it
# (§6); checksum validation off, since the offload these virtual interfaces
# present leaves the on-wire checksum unset; and, where hardware
# pattern-matching acceleration is unavailable, the bit-state matcher
# (§8.2).
#
# Capture size (siem.md §5): a sending host's kernel hands its virtual
# interface segments larger than the MTU, to be split by the receiving
# interface, and the zone bridge delivers them to the firewall unsplit; the
# kernel splits them only as they leave the firewall's other interface. A
# capture sized to the MTU truncates such a frame on the interface it arrives
# on and inspects none of its payload. The capture therefore accepts the
# largest IP packet, 65,535 bytes, with its 14-byte Ethernet header. The
# capture ring holds whole frames in blocks of 128 KiB, the smallest power of
# two that fits one, and Suricata keeps at least half of max-pending-packets
# frames in the ring, so max-pending-packets is lowered from 1024 to 128 to
# keep the ring at 64 frames (about 8.5 MB per capture thread rather than
# 67 MB); the boundary traffic is far below what that limits. The interfaces
# are named on the command line, not in this file, so these settings, like
# the checksum setting, go in the `default` entry they inherit. The file is
# written with its keys in their original order: with `interface` no longer
# the first key of that entry, Suricata reports a configuration problem at
# start-up.
incus file push build/suricata/{{ node_name }}.env "$BUILD_CTR/etc/suricata/interfaces.env"
incus exec "$BUILD_CTR" -- tee /tmp/patch_suricata.py > /dev/null << 'PYEOF'
import subprocess
import yaml

PATH = "/etc/suricata/suricata.yaml"
with open(PATH) as f:
    text = f.read()
_, body = text.split("---\n", 1)
cfg = yaml.safe_load(body)

cfg["vars"]["address-groups"]["HOME_NET"] = "[{{ internal_cidrs | join(',') }}]"
cfg["vars"]["address-groups"]["EXTERNAL_NET"] = "!$HOME_NET"

cfg["default-rule-path"] = "/etc/suricata/rules/et-open"
import os
cfg["rule-files"] = sorted(
    f for f in os.listdir("/etc/suricata/rules/et-open") if f.endswith(".rules")
)

for out in cfg["outputs"]:
    if "eve-log" in out:
        out["eve-log"]["enabled"] = True
        out["eve-log"]["types"] = [
            {"alert": {"payload": True, "payload-printable": True, "metadata": True}},
            {"flow": {}},
        ]

capture = next(e for e in cfg["af-packet"] if e.get("interface") == "default")
capture["checksum-checks"] = "no"
capture["tpacket-v3"] = True
capture["block-size"] = 131072
capture["ring-size"] = 64
cfg["default-packet-size"] = 65549
cfg["max-pending-packets"] = 128
cfg["stream"]["checksum-validation"] = False
{% if flow_timeouts %}
# The flow timeouts that the additional override file sets (episodes.md §5.3,
# timings; deployment.md §7.3, additional override file).
{% for proto, states in flow_timeouts.items() %}
{% for state, seconds in states.items() %}
cfg["flow-timeouts"]["{{ proto }}"]["{{ state }}"] = {{ seconds }}
{% endfor %}
{% endfor %}
{% endif %}

arch = subprocess.run(["uname", "-m"], capture_output=True, text=True, check=True).stdout.strip()
cfg["mpm-algo"] = "ac-bs" if arch == "aarch64" else "auto"

with open(PATH, "w") as f:
    f.write("%YAML 1.1\n---\n")
    yaml.safe_dump(cfg, f, sort_keys=False)
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/patch_suricata.py
incus exec "$BUILD_CTR" -- rm /tmp/patch_suricata.py

# The packaged unit starts on a single interface named in suricata.yaml
# itself; this deployment names two interfaces per firewall node and they
# differ per node, so the unit is replaced by one that reads the rendered
# interface list (siem.md §8.4) and passes one --af-packet flag per
# interface. Automatic rule updates are masked rather than merely disabled,
# so the timer cannot be re-enabled by a later package upgrade — no deployed
# instance has outbound internet access in any case (siem.md §8.3), but the
# rule set must never be updated at run time even if it did.
incus exec "$BUILD_CTR" -- systemctl mask suricata.service suricata-update.timer suricata-update.service
incus exec "$BUILD_CTR" -- tee /usr/local/sbin/suricata-launch.sh > /dev/null << 'LAUNCHEOF'
#!/bin/sh
set -eu
. /etc/suricata/interfaces.env
args=""
for iface in $SURICATA_INTERFACES; do
    args="$args --af-packet=$iface"
done
exec /usr/bin/suricata -c /etc/suricata/suricata.yaml $args
LAUNCHEOF
incus exec "$BUILD_CTR" -- chmod 0755 /usr/local/sbin/suricata-launch.sh
incus exec "$BUILD_CTR" -- tee /etc/systemd/system/ravensport-suricata.service > /dev/null << 'UNIT'
[Unit]
Description=Suricata IDS (RavensPort boundary inspection)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/sbin/suricata-launch.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target
UNIT

# Suricata's event file (siem.md §3, §8.2): not carried by the journal, so it
# is a file input alongside the agent's default journald collection — the
# same pattern fms-01.sh.j2 uses for PostgreSQL's own log file.
incus exec "$BUILD_CTR" -- tee /tmp/patch_agent_localfile.py > /dev/null << 'PYEOF'
PATH = "/var/ossec/etc/ossec.conf"
with open(PATH) as f:
    text = f.read()
text = text.replace(
    "</ossec_config>",
    "  <localfile>\n"
    "    <log_format>json</log_format>\n"
    "    <location>/var/log/suricata/eve.json</location>\n"
    "  </localfile>\n"
    "</ossec_config>",
)
with open(PATH, "w") as f:
    f.write(text)
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/patch_agent_localfile.py
incus exec "$BUILD_CTR" -- rm /tmp/patch_agent_localfile.py

incus exec "$BUILD_CTR" -- systemctl daemon-reload
incus exec "$BUILD_CTR" -- systemctl enable nftables ravensport-hosts.service systemd-networkd chrony ravensport-suricata.service
{% include "_no-external-services.sh.j2" %}
# Purge cloud-init — remove the package and residue rather than disabling it,
# so the tree cannot be re-created on the next boot.
incus exec "$BUILD_CTR" -- cloud-init clean --logs --seed
incus exec "$BUILD_CTR" -- apt-get purge -y cloud-init
incus exec "$BUILD_CTR" -- rm -rf /var/lib/cloud /etc/cloud
{% include "_clear-build-logs.sh.j2" %}

incus stop "$BUILD_CTR"
incus image delete "$IMAGE_ALIAS" 2>/dev/null || true
incus publish "$BUILD_CTR" --alias "$IMAGE_ALIAS"
incus image set-property "$IMAGE_ALIAS" "ravensport.input-hash" "$current_hash"
echo "==> $IMAGE_ALIAS ready"
