#!/usr/bin/env bash
# Build image for fms-01. Generated by render.py.
set -euo pipefail
cd "$(dirname "$0")/../.."

FMS_BIN="${FMS_SRC:-../fms}/target/release/fms"
if [ ! -x "$FMS_BIN" ]; then
    echo "ERROR: FMS binary not found at $FMS_BIN — run make build-fms first." >&2
    exit 1
fi
if [ ! -f build/tls/fms-01/cert.pem ] || [ ! -f build/tls/fms-01/key.pem ]; then
    echo "ERROR: CA-signed certificate not found at build/tls/fms-01/ — run make build-ca first." >&2
    exit 1
fi
# The two halves have two producers: render.py rewrites key.pem on every render,
# while cert.pem is build-ca.sh's and is preserved across a render. A render
# following a changed crypto.password_salt_seed or crypto.ca_not_before
# therefore leaves a new key beside a certificate signed from the previous one —
# both present, both valid, no longer a pair. Running this script directly
# rather than through `make build-node-images` skips the build-ca dependency and
# would install that mismatch, which rustls rejects at FMS startup. Comparing
# the moduli is the only check that distinguishes a stale certificate from a
# current one; existence, above, does not.
if [ "$(openssl x509 -noout -modulus -in build/tls/fms-01/cert.pem)" \
  != "$(openssl rsa -noout -modulus -in build/tls/fms-01/key.pem)" ]; then
    echo "ERROR: build/tls/fms-01/cert.pem was not signed for key.pem — the two are from different renders. Run make build-ca first." >&2
    exit 1
fi

IMAGE_ALIAS="ravensport/fms-01:latest"
BUILD_CTR="rpbuildfms01-$$"
_RND=$(printf '%04x' $((RANDOM)))
BUILD_NET="rpbfms01${_RND}"

cleanup() {
    incus delete -f "$BUILD_CTR" 2>/dev/null || true
    incus network delete "$BUILD_NET" 2>/dev/null || true
}
trap cleanup EXIT

current_hash=$(sha256sum \
    build/node-build/fms-01.sh \
    build/env/fms-01.env \
    build/network-config/fms-01.yaml \
    build/hosts/{{ node_name }} \
    build/chrony/{{ node_name }}.conf \
    build/ssh/{{ node_name }}/ssh_host_ed25519_key \
    build/ssh/{{ node_name }}/ssh_host_ed25519_key.pub \
    build/ssh/{{ node_name }}/authorized_keys \
    build/tls/fms-01/cert.pem \
    build/tls/fms-01/key.pem \
    build/ca/ca.pem \
    "$FMS_BIN" \
    build/siem/{{ node_name }}.key \
    build-scripts/keys/wazuh-repo.gpg \
    build/nftables/{{ node_name }}.nft \
    build-scripts/ulogd.conf \
  | sha256sum | cut -d' ' -f1)
stored_hash=$(incus image get-property "$IMAGE_ALIAS" "ravensport.input-hash" 2>/dev/null || echo "")
if [ "$current_hash" = "$stored_hash" ]; then
    echo "  fms-01: inputs unchanged, skipping"; exit 0
fi

echo "==> Building $IMAGE_ALIAS"
incus network create "$BUILD_NET" \
    ipv4.address=10.98.1.1/24 ipv4.nat=true \
    ipv6.address=none dns.mode=none
incus launch images:ubuntu/24.04/cloud "$BUILD_CTR" --network "$BUILD_NET"
incus exec "$BUILD_CTR" -- cloud-init status --wait
# The base image's package index is frozen at its daily's build time, and the
# pool keeps only current versions, so a package superseded since then 404s.
incus exec "$BUILD_CTR" -- apt-get update
incus exec "$BUILD_CTR" -- apt-get install -y postgresql argon2
incus exec "$BUILD_CTR" -- apt-get install -y chrony
{% include "_managed-ssh.sh.j2" %}

# Create system user
incus exec "$BUILD_CTR" -- useradd --system --no-create-home \
    --shell /usr/sbin/nologin fms

# Install binary
incus file push --mode 0755 "$FMS_BIN" "$BUILD_CTR/usr/local/bin/fms"

# Install env file
incus exec "$BUILD_CTR" -- mkdir -p /etc/fms/tls
incus file push --mode 0640 build/env/fms-01.env "$BUILD_CTR/etc/fms/fms.env"
incus exec "$BUILD_CTR" -- chown root:fms /etc/fms /etc/fms/fms.env
incus exec "$BUILD_CTR" -- chmod 750 /etc/fms

# CA-signed TLS certificate (digital.md §8 decision 7). Generated by
# build-ca.sh; the FMS binary has no self-sign fallback and fails to start
# if these are missing.
incus file push --mode 0640 build/tls/fms-01/cert.pem "$BUILD_CTR/etc/fms/tls/cert.pem"
incus file push --mode 0600 build/tls/fms-01/key.pem "$BUILD_CTR/etc/fms/tls/key.pem"
incus exec "$BUILD_CTR" -- chown fms:fms /etc/fms/tls /etc/fms/tls/cert.pem /etc/fms/tls/key.pem
incus exec "$BUILD_CTR" -- chmod 750 /etc/fms/tls

# Install systemd unit
incus exec "$BUILD_CTR" -- tee /etc/systemd/system/fms.service > /dev/null <<'UNIT'
[Unit]
Description=Fuel Management System
After=network-online.target postgresql.service
Wants=postgresql.service

[Service]
User=fms
EnvironmentFile=/etc/fms/fms.env
EnvironmentFile=-/etc/fms/test-overrides.env
ExecStart=/usr/local/bin/fms
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
UNIT

# Every session's start and end is logged as well as every failure (fms.md
# §9.2, siem.md §3): the packaged default logs only failures and errors.
# The packaged postgresql.conf reads conf.d.
incus exec "$BUILD_CTR" -- bash -c '
set -- /etc/postgresql/*/main/conf.d
[ "$#" -eq 1 ] && [ -d "$1" ] \
    || { echo "ERROR: expected one PostgreSQL cluster, found: $*" >&2; exit 1; }
printf "log_connections = on\nlog_disconnections = on\n" > "$1/ravensport-logging.conf"
'

# Create the FMS PostgreSQL role and empty database (runs while the build
# container is up). The schema — including card_table — is applied by the FMS's
# sqlx migration at first boot, which then enrols the FMS_SEED_CARDS entries
# (fms.env) not already present, so a fresh deploy needs no manual card enrolment.
incus exec "$BUILD_CTR" -- bash -c \
    'systemctl start postgresql && \
     sudo -u postgres createuser fms && \
     sudo -u postgres createdb -O fms fms'

# Netplan and hosts
incus file push --mode 0600 build/network-config/fms-01.yaml \
    "$BUILD_CTR/etc/netplan/99-ravensport.yaml"
incus exec "$BUILD_CTR" -- rm -f /etc/netplan/50-cloud-init.yaml
# Generate systemd-networkd .network unit files by parsing the netplan YAML
# directly.  Using the netplan CLI's generator is unreliable: it targets
# /run/systemd/network/ (a tmpfs) which is not preserved in the published
# image, and renderer detection may select NetworkManager rather than networkd.
incus exec "$BUILD_CTR" -- tee /tmp/gen-networkd.py > /dev/null << 'PYEOF'
import yaml, os
os.makedirs("/etc/systemd/network", exist_ok=True)
with open("/etc/netplan/99-ravensport.yaml") as f:
    cfg = yaml.safe_load(f)
for iface, spec in (cfg.get("ethernets") or {}).items():
    lines = ["[Match]", f"Name={iface}", "", "[Network]"]
    for addr in (spec.get("addresses") or []):
        lines.append(f"Address={addr}")
    routes = spec.get("routes") or []
    for r in routes:
        if str(r.get("to")) == "default":
            lines.append(f"Gateway={r['via']}")
    for dns in ((spec.get("nameservers") or {}).get("addresses") or []):
        lines.append(f"DNS={dns}")
    for r in routes:
        if str(r.get("to")) != "default":
            lines += ["", "[Route]", f"Destination={r['to']}", f"Gateway={r['via']}"]
    path = f"/etc/systemd/network/10-ravensport-{iface}.network"
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    print(f"Wrote {path}")
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/gen-networkd.py
incus exec "$BUILD_CTR" -- rm /tmp/gen-networkd.py
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts"
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts.ravensport"
incus file push build/chrony/{{ node_name }}.conf "$BUILD_CTR/etc/chrony/chrony.conf"

incus exec "$BUILD_CTR" -- tee /etc/systemd/system/ravensport-hosts.service > /dev/null <<'UNIT'
[Unit]
Description=Restore /etc/hosts from Ravensport canonical source
DefaultDependencies=no
Before=network-pre.target sysinit.target
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/bin/cp /etc/hosts.ravensport /etc/hosts
RemainAfterExit=yes
[Install]
WantedBy=sysinit.target
UNIT
{% include "_trust_ca.sh.j2" %}
{% include "_wazuh-agent.sh.j2" %}
# PostgreSQL's own log file (siem.md §3, §8.2): not carried by the journal, so
# it is a file input alongside the agent's default journald collection.
incus exec "$BUILD_CTR" -- tee /tmp/patch_agent_localfile.py > /dev/null << 'PYEOF'
PATH = "/var/ossec/etc/ossec.conf"
with open(PATH) as f:
    text = f.read()
text = text.replace(
    "</ossec_config>",
    "  <localfile>\n"
    "    <log_format>syslog</log_format>\n"
    "    <location>/var/log/postgresql/*.log</location>\n"
    "  </localfile>\n"
    "</ossec_config>",
)
with open(PATH, "w") as f:
    f.write(text)
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/patch_agent_localfile.py
incus exec "$BUILD_CTR" -- rm /tmp/patch_agent_localfile.py
incus exec "$BUILD_CTR" -- systemctl daemon-reload
incus exec "$BUILD_CTR" -- systemctl enable fms.service ravensport-hosts.service systemd-networkd chrony
incus exec "$BUILD_CTR" -- systemctl stop postgresql
{% include "_no-external-services.sh.j2" %}
# Purge cloud-init — remove the package and residue rather than disabling it,
# so the tree cannot be re-created on the next boot.
incus exec "$BUILD_CTR" -- cloud-init clean --logs --seed
incus exec "$BUILD_CTR" -- apt-get purge -y cloud-init
incus exec "$BUILD_CTR" -- rm -rf /var/lib/cloud /etc/cloud
{% include "_clear-build-logs.sh.j2" %}

incus stop "$BUILD_CTR"
incus image delete "$IMAGE_ALIAS" 2>/dev/null || true
incus publish "$BUILD_CTR" --alias "$IMAGE_ALIAS"
incus image set-property "$IMAGE_ALIAS" "ravensport.input-hash" "$current_hash"
echo "==> $IMAGE_ALIAS ready"
