#!/usr/bin/env bash
# Build image for siem-01. Generated by render.py.
set -euo pipefail
cd "$(dirname "$0")/../.."

if [ ! -f build/tls/siem-01/cert.pem ] || [ ! -f build/tls/siem-01/key.pem ]; then
    echo "ERROR: CA-signed certificate not found at build/tls/siem-01/ — run make build-ca first." >&2
    exit 1
fi
# The two halves have two producers: render.py rewrites key.pem on every render,
# while cert.pem is build-ca.sh's and is preserved across a render. A render
# following a changed crypto.password_salt_seed or crypto.ca_not_before
# therefore leaves a new key beside a certificate signed from the previous one.
# Comparing the moduli is the only check that distinguishes a stale certificate
# from a current one; existence, above, does not.
if [ "$(openssl x509 -noout -modulus -in build/tls/siem-01/cert.pem)" \
  != "$(openssl rsa -noout -modulus -in build/tls/siem-01/key.pem)" ]; then
    echo "ERROR: build/tls/siem-01/cert.pem was not signed for key.pem — the two are from different renders. Run make build-ca first." >&2
    exit 1
fi

{% include "_artefacts.sh.j2" %}

# Fetched before the input hash below reads it, and before any container
# exists to clean up if a download fails.
ICS_ATTACK_JSON=$(fetch_artefact ics-attack-stix)

{# The operational image, or the image that an additional override file names
   (deployment.md §7.3). #}
IMAGE_ALIAS="{{ image_name }}"
BUILD_CTR="rpbuildsiem01-$$"
_RND=$(printf '%04x' $((RANDOM)))
BUILD_NET="rpbsiem01${_RND}"

cleanup() {
    incus delete -f "$BUILD_CTR" 2>/dev/null || true
    incus network delete "$BUILD_NET" 2>/dev/null || true
}
trap cleanup EXIT

current_hash=$(sha256sum \
    build/node-build/siem-01.sh \
    build/network-config/siem-01.yaml \
    build/hosts/{{ node_name }} \
    build/chrony/{{ node_name }}.conf \
    build/siem/client.keys \
    build/siem/siem-01-admin-seed.sql \
    build-scripts/keys/wazuh-repo.gpg \
    build/tls/siem-01/cert.pem \
    build/tls/siem-01/key.pem \
    build/ca/ca.pem \
{# A template that extends this one hashes the files it adds (episodes.md §3.4). #}
{% block extra_hash_inputs %}{% endblock %}
    "$ICS_ATTACK_JSON" \
  | sha256sum | cut -d' ' -f1)
stored_hash=$(incus image get-property "$IMAGE_ALIAS" "ravensport.input-hash" 2>/dev/null || echo "")
if [ "$current_hash" = "$stored_hash" ]; then
    echo "  siem-01: inputs unchanged, skipping"; exit 0
fi

echo "==> Building $IMAGE_ALIAS"
incus network create "$BUILD_NET" \
    ipv4.address=10.98.9.1/24 ipv4.nat=true \
    ipv6.address=none dns.mode=none
incus launch images:ubuntu/24.04/cloud "$BUILD_CTR" --network "$BUILD_NET"
incus exec "$BUILD_CTR" -- cloud-init status --wait
# The base image's package index is frozen at its daily's build time, and the
# pool keeps only current versions, so a package superseded since then 404s.
incus exec "$BUILD_CTR" -- apt-get update
incus exec "$BUILD_CTR" -- apt-get install -y chrony sqlite3

# The repository signing key is committed pre-dearmored
# (build-scripts/keys/wazuh-repo.gpg) rather than fetched at build time
# (siem.md §8.4).
incus file push build-scripts/keys/wazuh-repo.gpg \
    "$BUILD_CTR/usr/share/keyrings/wazuh.gpg"
incus exec "$BUILD_CTR" -- bash -c '
echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" \
    > /etc/apt/sources.list.d/wazuh.list
apt-get update -qq
apt-get install -y wazuh-manager=4.14.7-1
'

# ── Configuration (siem.md §2.2, §6, §8.3, §8.5) ─────────────────────────────
incus file push build/siem/client.keys "$BUILD_CTR/var/ossec/etc/client.keys"

# logall_json (archives.json, siem.md §6), disabling vulnerability
# detection (no outbound internet once deployed, siem.md §8.3), disabling
# the enrolment service (keys are derived at render time, siem.md §8.1), and
# the manager's monitoring of its own host — file integrity monitoring and
# inventory exactly as every agent runs them, from the same
# _host-monitoring.xml.j2, with rootcheck and configuration assessment off
# (siem.md §2.1) — are patched into the packaged default rather than the
# whole file rewritten, since the
# rest of the packaged ossec.conf's ruleset/decoder paths are correct as
# shipped. Wazuh's ossec.conf is not always well-formed single-root XML (some
# packaged defaults concatenate multiple <ossec_config> blocks), so this
# edits text rather than risk a parser rejecting a file the product itself
# accepts.
incus exec "$BUILD_CTR" -- tee /tmp/host-monitoring.xml > /dev/null << 'XMLEOF'
{% include "_host-monitoring.xml.j2" %}
XMLEOF
incus exec "$BUILD_CTR" -- tee /tmp/patch_ossec.py > /dev/null << 'PYEOF'
import re
PATH = "/var/ossec/etc/ossec.conf"
with open(PATH) as f:
    text = f.read()
# Each packaged monitoring block is removed, and the shared ones inserted in
# their place. Exactly one of each is expected: a package whose default
# differs fails the build rather than leaving a second, packaged block active.
for pattern in (
    r"\n\s*<syscheck>.*?</syscheck>",
    r"\n\s*<rootcheck>.*?</rootcheck>",
    r"\n\s*<sca>.*?</sca>",
    r'\n\s*<wodle name="syscollector">.*?</wodle>',
):
    text, n = re.subn(pattern, "", text, count=0, flags=re.DOTALL)
    if n != 1:
        raise SystemExit(f"ossec.conf: expected one block matching {pattern!r}, found {n}")
# The listening-port report (siem.md §2.1, §4.3): the packaged command, on the
# schedule render.py divides by the compression factor (siem.md §8.5).
text, n = re.subn(
    r"(<alias>netstat listening ports</alias>\s*<frequency>)\s*\d+\s*(</frequency>)",
    r"\g<1>{{ siem_schedules.listening_port_s }}\g<2>",
    text,
)
if n != 1:
    raise SystemExit(f"ossec.conf: expected one netstat listening-ports block, found {n}")
with open("/tmp/host-monitoring.xml") as f:
    monitoring = f.read().rstrip() + "\n"
text = text.replace("</ossec_config>", monitoring + "</ossec_config>", 1)
if "<logall_json>" in text:
    text = re.sub(r"<logall_json>\s*no\s*</logall_json>",
                   "<logall_json>yes</logall_json>", text)
else:
    text = text.replace("<global>", "<global>\n    <logall_json>yes</logall_json>", 1)
if "<vulnerability-detection>" in text:
    text = re.sub(
        r"(<vulnerability-detection>.*?<enabled>)\s*yes\s*(</enabled>)",
        r"\1no\2", text, flags=re.DOTALL,
    )
else:
    text += "\n<ossec_config>\n  <vulnerability-detection>\n    <enabled>no</enabled>\n  </vulnerability-detection>\n</ossec_config>\n"
text, n = re.subn(
    r"(<auth>\s*<disabled>)\s*no\s*(</disabled>)", r"\1yes\2", text, flags=re.DOTALL
)
if n != 1:
    raise SystemExit("ossec.conf: expected one <auth><disabled>no</disabled> block")
with open(PATH, "w") as f:
    f.write(text)
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/patch_ossec.py
incus exec "$BUILD_CTR" -- rm /tmp/patch_ossec.py /tmp/host-monitoring.xml

# Decoders for the two file inputs of siem.md §3 that the packaged ruleset
# does not already cover. PostgreSQL's own default
# `log_line_prefix` on this base image — `%m [%p] %q%u@%d `, unbracketed, with
# the timezone appended to the timestamp — does not match the packaged
# `postgresql_log` decoder, which expects a bracketed
# `[timestamp tz] client_ip: ` prefix. `%q` omits `user@database` from a
# background process's lines (checkpoints, start-up), so it is optional here;
# a session's lines carry it, `[unknown]@[unknown]` before authentication.
# The user is `srcuser`, as the packaged sshd decoder names the account a
# login attempts. sssd's domain log carries no packaged
# decoder at all. `type="pcre2"` is set throughout: the default OSSEC regex
# dialect accepts neither an escaped literal bracket nor an escaped literal
# dot, both of which these formats require.
incus exec "$BUILD_CTR" -- tee -a /var/ossec/etc/decoders/local_decoder.xml > /dev/null <<'DECODEREOF'

<decoder name="ravensport-postgresql">
  <prematch type="pcre2">^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+ \S+ \[\d+\] </prematch>
  <regex type="pcre2" offset="after_prematch">^(?:(\S+)@(\S*) )?(\w+):\s+(.+)$</regex>
  <order>srcuser, database, status, extra_data</order>
</decoder>

<decoder name="ravensport-sssd-domain">
  <prematch type="pcre2">^\(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\): \[be\[\w+\]\] </prematch>
  <regex type="pcre2" offset="after_prematch">^\[(\w+)\] \(0x[0-9a-f]+\): (.+)$</regex>
  <order>status, extra_data</order>
</decoder>
DECODEREOF

# RavensPort boundary rules (siem.md §2.2, §5): each attaches an ATT&CK
# technique that the manager's own packaged Suricata rule (86601, which only
# echoes the matched signature's own name) does not. A set command or a
# disallowed function code sent to the tank gauge console carries T1692.001
# (Command Message, tactics Evasion and Impair Process Control) from the
# ATT&CK for Industrial Control Systems matrix imported below. It is the
# successor MITRE names for T0855 (Unauthorized Command Message), which the
# pinned matrix revokes and so cannot be resolved. A port carrying something
# other than the protocol it was opened for — non-Tank-Level-System traffic
# on 10001 or data outside a command there, non-TLS traffic on 443, 636, 8428
# or 9428, or non-NTP traffic on 123 — carries T1571 (Non-Standard Port) from
# the packaged Enterprise matrix.
# `pcre2` is used for the field match: the default OSSEC regex dialect accepts
# neither the anchors nor the character class the signature-identifier match
# needs.
incus exec "$BUILD_CTR" -- tee -a /var/ossec/etc/rules/local_rules.xml > /dev/null <<'RULEEOF'

<group name="ravensport,">
  <rule id="100101" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">^100000[12]$</field>
    <description>Suricata: Tank Level System boundary violation - $(alert.signature)</description>
    <mitre>
      <id>T1692.001</id>
    </mitre>
    <group>tls_protocol,</group>
  </rule>

  <rule id="100102" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id" type="pcre2">^100000[34578]$</field>
    <description>Suricata: protocol conformance violation on a permitted port - $(alert.signature)</description>
    <mitre>
      <id>T1571</id>
    </mitre>
    <group>protocol_conformance,</group>
  </rule>
</group>
RULEEOF

# PostgreSQL password failures on fms-01 (siem.md §3) carry T1110.001
# (Password Guessing), as the packaged sshd failure rules do. The packaged
# PostgreSQL rules depend on the packaged `postgresql_log` decoder, which
# these lines do not match (above), and its failure rule (50512) carries no
# technique. The packaged generic failure rule 2501 matches the message text
# of any decoder and is evaluated first, so this rule refines it. Repeated
# failures for one database user carry T1110 (Brute Force), with the
# threshold, window and quiet period of the packaged SSH brute-force rule
# (5763): eight within 120 seconds, then none for 60.
incus exec "$BUILD_CTR" -- tee -a /var/ossec/etc/rules/local_rules.xml > /dev/null <<'PGRULEEOF'

<group name="ravensport,postgresql,">
  <rule id="100110" level="9">
    <if_sid>2501</if_sid>
    <decoded_as>ravensport-postgresql</decoded_as>
    <status>^FATAL$</status>
    <match>password authentication failed for user</match>
    <description>PostgreSQL: Database authentication failure for $(srcuser).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100111" level="10" frequency="8" timeframe="120" ignore="60">
    <if_matched_sid>100110</if_matched_sid>
    <same_srcuser />
    <description>PostgreSQL: Repeated database authentication failures for $(srcuser).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>
</group>
PGRULEEOF

# The ATT&CK for Industrial Control Systems matrix (siem.md §2.2, §8.4): the
# manager ships only the Enterprise matrix, and this import makes the ICS
# techniques resolvable by the rule loader, as T1692.001 above requires.
# Each tactic needs a `reference` row (type `tactic`) as well as its `tactic`
# row: at every start the manager's analysis daemon loads the whole matrix,
# and a tactic without a reference aborts that load ("It was not possible to
# get Mitre tactic name"), leaving every technique after it — every imported
# one included — unresolved. mitre.db is part of the
# wazuh-manager package payload, not created by the manager's own first
# start (unlike rbac.db below), so this can run before the service exists to
# be stopped. Every table the manager's own import would populate is filled,
# for a complete and directly queryable technique database, matching the
# tactic/technique/platform/sub-technique structure the packaged Enterprise
# data already has: technique, reference, platform, tactic and phase (the
# technique-to-tactic join, keyed by the kill-chain phase name); the
# group/software/mitigation tables carry no ICS content in this bundle and
# serve the management interface's own ATT&CK browsing views regardless,
# which this deployment does not expose (siem.md §6, "does not serve
# alerts").
incus file push "$ICS_ATTACK_JSON" "$BUILD_CTR/tmp/ics-attack.json"
incus exec "$BUILD_CTR" -- tee /tmp/import_ics_attack.py > /dev/null << 'PYEOF'
import json
import sqlite3

with open("/tmp/ics-attack.json") as f:
    bundle = json.load(f)

conn = sqlite3.connect("/var/ossec/var/db/mitre.db")
cur = conn.cursor()

tactic_by_shortname = {}
for obj in bundle["objects"]:
    if obj.get("type") != "x-mitre-tactic":
        continue
    stix_id = obj["id"]
    shortname = obj.get("x_mitre_shortname")
    tactic_by_shortname[shortname] = stix_id
    cur.execute(
        """
        INSERT OR REPLACE INTO tactic (id, name, description, created_time, modified_time, short_name)
        VALUES (?, ?, ?, ?, ?, ?)
        """,
        (
            stix_id,
            obj["name"],
            obj.get("description"),
            obj.get("created"),
            obj.get("modified"),
            shortname,
        ),
    )
    for ref in obj.get("external_references", []):
        if ref.get("source_name") != "mitre-attack" or "external_id" not in ref:
            continue
        cur.execute(
            """
            INSERT OR REPLACE INTO reference (id, source, external_id, url, description, type)
            VALUES (?, 'mitre-attack', ?, ?, NULL, 'tactic')
            """,
            (stix_id, ref["external_id"], ref.get("url", "")),
        )

subtechnique_of = {}
revoked_by = {}
for obj in bundle["objects"]:
    if obj.get("type") != "relationship":
        continue
    if obj.get("relationship_type") == "subtechnique-of":
        subtechnique_of[obj["source_ref"]] = obj["target_ref"]
    elif obj.get("relationship_type") == "revoked-by":
        revoked_by[obj["source_ref"]] = obj["target_ref"]

for obj in bundle["objects"]:
    if obj.get("type") != "attack-pattern":
        continue
    stix_id = obj["id"]
    deprecated = 1 if obj.get("x_mitre_deprecated") else 0
    cur.execute(
        """
        INSERT OR REPLACE INTO technique
            (id, name, description, created_time, modified_time,
             mitre_version, mitre_detection, network_requirements,
             remote_support, revoked_by, deprecated, subtechnique_of)
        VALUES (?, ?, ?, ?, ?, ?, ?, NULL, NULL, ?, ?, ?)
        """,
        (
            stix_id,
            obj["name"],
            obj.get("description"),
            obj.get("created"),
            obj.get("modified"),
            obj.get("x_mitre_version"),
            obj.get("x_mitre_detection"),
            revoked_by.get(stix_id),
            deprecated,
            subtechnique_of.get(stix_id),
        ),
    )
    for ref in obj.get("external_references", []):
        if ref.get("source_name") != "mitre-attack" or "external_id" not in ref:
            continue
        cur.execute(
            """
            INSERT OR REPLACE INTO reference (id, source, external_id, url, description, type)
            VALUES (?, 'mitre-attack', ?, ?, NULL, 'technique')
            """,
            (stix_id, ref["external_id"], ref.get("url", "")),
        )
    for platform in obj.get("x_mitre_platforms") or []:
        cur.execute(
            "INSERT OR REPLACE INTO platform (id, platform, type) VALUES (?, ?, 'technique')",
            (stix_id, platform),
        )
    for phase_entry in obj.get("kill_chain_phases") or []:
        tactic_id = tactic_by_shortname.get(phase_entry["phase_name"])
        if tactic_id:
            cur.execute(
                "INSERT OR REPLACE INTO phase (tactic_id, tech_id) VALUES (?, ?)",
                (tactic_id, stix_id),
            )
conn.commit()
conn.close()
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/import_ics_attack.py
incus exec "$BUILD_CTR" -- rm /tmp/import_ics_attack.py /tmp/ics-attack.json

# Retention (siem.md §7): the analysis daemon writes each day's alerts and
# archives into a dated file, monitord compresses previous days'
# (monitord.compress, the packaged default), and nothing deletes them.
# monitord.keep_log_days applies only to the manager's operational log,
# ossec.log; it is raised from the packaged 31 days to its maximum of 500,
# so that log is kept as long as the setting allows. The system logrotate
# utility plays no part: the manager's options are set in
# local_internal_options.conf, not a /etc/logrotate.d/ file.
incus exec "$BUILD_CTR" -- bash -c \
    "echo 'monitord.keep_log_days=500' >> /var/ossec/etc/local_internal_options.conf"

# ── Management interface certificate (siem.md §8.6) ──────────────────────────
# The manager's application-programming-interface daemon generates a
# self-signed certificate at its first start if none is present, and the
# first start is the one below. The authority-issued leaf is therefore
# installed before it, with the same ownership and mode the daemon gives its
# own generated pair, so nothing self-signed is ever generated.
incus file push build/tls/siem-01/cert.pem \
    "$BUILD_CTR/var/ossec/api/configuration/ssl/server.crt"
incus file push build/tls/siem-01/key.pem \
    "$BUILD_CTR/var/ossec/api/configuration/ssl/server.key"
incus exec "$BUILD_CTR" -- chown wazuh:wazuh \
    /var/ossec/api/configuration/ssl/server.crt \
    /var/ossec/api/configuration/ssl/server.key
incus exec "$BUILD_CTR" -- chmod 0400 \
    /var/ossec/api/configuration/ssl/server.crt \
    /var/ossec/api/configuration/ssl/server.key
# The packaged api.yaml carries every setting commented out; the https block
# is stated explicitly rather than left to the daemon's built-in defaults.
# Client-certificate verification stays off: callers authenticate with the
# credential of §8.5.
incus exec "$BUILD_CTR" -- bash -c 'cat >> /var/ossec/api/configuration/api.yaml' <<'APIEOF'

https:
  enabled: yes
  key: "server.key"
  cert: "server.crt"
  use_ca: False
APIEOF

# The enrolment service's own certificate and key, generated self-signed by
# the package at install. The service is disabled above (siem.md §8.1), so
# nothing reads them.
incus exec "$BUILD_CTR" -- rm /var/ossec/etc/sslmanager.cert /var/ossec/etc/sslmanager.key

# The management-interface credential (siem.md §8.5, deployment-config.md §6).
# rbac.db does not exist until the manager's own first start creates its
# schema and default rows, so the manager is started once, stopped, and the
# seed applied directly — the same start-once/seed/never-start-again pattern
# hist-01's/hist-dmz-01's Grafana seed uses.
incus exec "$BUILD_CTR" -- systemctl start wazuh-manager
# The manager creates rbac.db before it inserts the two default users, so the
# wait is for the users themselves: a seed applied to the empty table would
# change nothing and fail nothing, and the default superuser would be inserted
# after it. -readonly keeps sqlite3 from creating the file if it is not there
# yet.
incus exec "$BUILD_CTR" -- bash -c '
for _ in $(seq 1 60); do
    if [ "$(sqlite3 -readonly /var/ossec/api/configuration/security/rbac.db \
            "SELECT group_concat(username) FROM (SELECT username FROM users ORDER BY id);" \
            2>/dev/null)" = "wazuh,wazuh-wui" ]; then
        exit 0
    fi
    sleep 1
done
echo "ERROR: the manager did not create its default users within 60 seconds" >&2
tail -n 40 /var/ossec/logs/api.log /var/ossec/logs/ossec.log >&2 || true
exit 1
'
incus exec "$BUILD_CTR" -- systemctl stop wazuh-manager
# The first start must have loaded the whole ATT&CK matrix, the imported ICS
# matrix included: a failed load logs this line and leaves the rule loader
# unable to resolve any technique it had not yet reached.
incus exec "$BUILD_CTR" -- bash -c '
grep -q "wazuh-analysisd" /var/ossec/logs/ossec.log \
    || { echo "ERROR: wazuh-analysisd did not run during the first start" >&2; exit 1; }
if grep -q "Mitre matrix information could not be loaded" /var/ossec/logs/ossec.log; then
    echo "ERROR: the manager could not load the ATT&CK matrix:" >&2
    grep -i "mitre" /var/ossec/logs/ossec.log >&2
    exit 1
fi
'
# The first start must have presented the installed leaf rather than
# replacing it with a generated one.
incus exec "$BUILD_CTR" -- bash -c '
openssl x509 -noout -issuer -in /var/ossec/api/configuration/ssl/server.crt \
    | grep -q "CN = RavensPort Internal CA" \
    || { echo "ERROR: server.crt is not issued by the RavensPort Internal CA" >&2; exit 1; }
'
incus file push build/siem/siem-01-admin-seed.sql "$BUILD_CTR/tmp/siem-01-admin-seed.sql"
# The seed ends by checking its own result, since an UPDATE that matches no
# row succeeds. -bail stops at the first failing statement, the check
# included, with a non-zero exit that fails the build; without it sqlite3
# reports the error and exits 0.
incus exec "$BUILD_CTR" -- bash -c \
    'sqlite3 -bail /var/ossec/api/configuration/security/rbac.db < /tmp/siem-01-admin-seed.sql'
incus exec "$BUILD_CTR" -- rm /tmp/siem-01-admin-seed.sql

# The first start above is the build's: it wrote the manager's own logs, the
# build container's records into archives.json under the build container's
# hostname, and that hostname's agent row, file integrity baseline and
# inventory. All of it is removed, so the deployed manager's records begin at
# its own first start (siem.md §6). The log files are emptied rather than
# deleted, since the manager reads one of them (active-responses.log) and
# does not recreate it; the day's rotated copies are deleted. The package's
# directories and its one installed file among them, norm_config.json, are
# kept; the imported matrix (var/db) and the seeded credential (api/) lie
# outside these paths.
incus exec "$BUILD_CTR" -- bash -c '
cd /var/ossec
rm -rf logs/*/[0-9]* queue/diff/* queue/indexer/*
find logs -type f -exec truncate -s 0 {} +
find queue/db queue/fim/db queue/syscollector/db queue/logcollector \
    queue/rids queue/tasks stats -type f ! -name norm_config.json -delete
'
incus exec "$BUILD_CTR" -- bash -c "
if grep -rlI '$BUILD_CTR' /var/ossec; then
    echo 'ERROR: the build container hostname remains in the files above' >&2
    exit 1
fi
"

incus file push --mode 0600 build/network-config/siem-01.yaml \
    "$BUILD_CTR/etc/netplan/99-ravensport.yaml"
incus exec "$BUILD_CTR" -- rm -f /etc/netplan/50-cloud-init.yaml
# Generate systemd-networkd .network unit files by parsing the netplan YAML
# directly.  Using the netplan CLI's generator is unreliable: it targets
# /run/systemd/network/ (a tmpfs) which is not preserved in the published
# image, and renderer detection may select NetworkManager rather than networkd.
incus exec "$BUILD_CTR" -- tee /tmp/gen-networkd.py > /dev/null << 'PYEOF'
import yaml, os
os.makedirs("/etc/systemd/network", exist_ok=True)
with open("/etc/netplan/99-ravensport.yaml") as f:
    cfg = yaml.safe_load(f)
for iface, spec in (cfg.get("ethernets") or {}).items():
    lines = ["[Match]", f"Name={iface}", "", "[Network]"]
    for addr in (spec.get("addresses") or []):
        lines.append(f"Address={addr}")
    routes = spec.get("routes") or []
    for r in routes:
        if str(r.get("to")) == "default":
            lines.append(f"Gateway={r['via']}")
    for dns in ((spec.get("nameservers") or {}).get("addresses") or []):
        lines.append(f"DNS={dns}")
    for r in routes:
        if str(r.get("to")) != "default":
            lines += ["", "[Route]", f"Destination={r['to']}", f"Gateway={r['via']}"]
    path = f"/etc/systemd/network/10-ravensport-{iface}.network"
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
PYEOF
incus exec "$BUILD_CTR" -- python3 /tmp/gen-networkd.py
incus exec "$BUILD_CTR" -- rm /tmp/gen-networkd.py
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts"
incus file push build/hosts/{{ node_name }} "$BUILD_CTR/etc/hosts.ravensport"
incus file push build/chrony/{{ node_name }}.conf "$BUILD_CTR/etc/chrony/chrony.conf"

incus exec "$BUILD_CTR" -- tee /etc/systemd/system/ravensport-hosts.service > /dev/null <<'UNIT'
[Unit]
Description=Restore /etc/hosts from Ravensport canonical source
DefaultDependencies=no
Before=network-pre.target sysinit.target
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/bin/cp /etc/hosts.ravensport /etc/hosts
RemainAfterExit=yes
[Install]
WantedBy=sysinit.target
UNIT
{% include "_trust_ca.sh.j2" %}
incus exec "$BUILD_CTR" -- systemctl daemon-reload
incus exec "$BUILD_CTR" -- systemctl enable wazuh-manager ravensport-hosts.service systemd-networkd chrony
{% include "_no-external-services.sh.j2" %}
# Purge cloud-init — remove the package and residue rather than disabling it,
# so the tree cannot be re-created on the next boot.
incus exec "$BUILD_CTR" -- cloud-init clean --logs --seed
incus exec "$BUILD_CTR" -- apt-get purge -y cloud-init
incus exec "$BUILD_CTR" -- rm -rf /var/lib/cloud /etc/cloud
{% include "_clear-build-logs.sh.j2" %}

{# A template that extends this one adds its files before the image is
   published (episodes.md §3.4). #}
{% block extra_files %}{% endblock %}
incus stop "$BUILD_CTR"
incus image delete "$IMAGE_ALIAS" 2>/dev/null || true
incus publish "$BUILD_CTR" --alias "$IMAGE_ALIAS"
incus image set-property "$IMAGE_ALIAS" "ravensport.input-hash" "$current_hash"
echo "==> $IMAGE_ALIAS ready"
